{
  "name": "sunworks-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild-headers.mjs",
    "preview": "wrangler dev -c dist/server/wrangler.json --port 8788 --ip 127.0.0.1",
    "check": "astro check",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply sunworks-db --local -c dist/server/wrangler.json",
    "db:migrate:remote": "wrangler d1 migrations apply sunworks-db --remote",
    "links": "linkinator dist/client --recurse --skip '^(?!http://localhost)' --silent",
    "deploy": "npm run build && wrangler deploy",
    "sanity:seed": "tsx scripts/sanity-seed.ts",
    "sanity:import": "tsx scripts/sanity-import.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "astro": "^7.3.5",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-security": "^4.1.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "linkinator": "^8.1.0",
    "simple-icons": "^16.33.0",
    "svg-path-bbox": "^2.1.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.142.0"
  },
  "overrides": {
    "undici@7": "^7.30.0"
  }
}
