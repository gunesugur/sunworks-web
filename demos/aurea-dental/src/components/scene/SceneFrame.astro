---
/** Shared editorial shell. Sections stay in document flow; only their own controls animate. */
interface Props {
  name: string;
  section?: string;
  id?: string;
  labelledby?: string;
  label?: string;
  as?: 'section' | 'footer' | 'div';
  frame?: 'stage' | 'panel' | 'column';
  height?: 'stage' | 'fixed' | 'auto';
  tone?: 'surface' | 'muted' | 'bg' | 'soft' | 'photo';
  class?: string;
  stageClass?: string;
}
const {name,section,id,labelledby,label,as:Tag='section',frame='stage',height='stage',tone='surface',class:className,stageClass}=Astro.props;
---
<Tag id={id} class:list={['scene',`scene--${frame}`,className]} data-scene={name} data-section={section} data-enter="flow" data-pin={frame==='stage'?'none':undefined} data-height={frame==='stage'?height:undefined} data-tone={tone} aria-labelledby={labelledby} aria-label={label}>
  {frame==='stage' ? <div class="scene__pin"><div class:list={['stage',stageClass]} data-stage><slot /></div></div> : <div class:list={[frame==='panel'?'panel':'scene__column',stageClass]} data-stage><slot /></div>}
  <slot name="after" />
</Tag>
