---
/** Compatibility wrapper for existing panel components; it has no rise or overlap behavior. */
import SceneFrame from './SceneFrame.astro';
import type { ComponentProps } from 'astro/types';
type Props = ComponentProps<typeof SceneFrame>;
const { frame='panel',...rest }=Astro.props;
---
<SceneFrame {...rest} frame={frame}><slot /><slot name="after" slot="after" /></SceneFrame>
