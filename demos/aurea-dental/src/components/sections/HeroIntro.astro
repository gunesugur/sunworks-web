---
/**
 * Scene 1 — Hero (docs/AUREA_MOTION_RULE_KIT_V3.md §5). SceneFrame stage, height fixed, pinned ≥640 for the
 * intro's short rise (hand-off 1 is built by motion/scenes.ts). Load timeline in scripts/sections/hero.ts:
 * a 21:9 window at 48 % of the stage width (clip bounds + cover-fit inner scale) opens to the full stage,
 * then header, line-masked headline, copy + ONE dark CTA and a quiet text action.
 * Phones: the image fills a 76svh stage and the text sits under it (no text over the photo).
 */
import { site } from '../../content/site';
import SceneFrame from '../scene/SceneFrame.astro';
import MaskedMedia from '../scene/MaskedMedia.astro';
import Button from '../ui/Button.astro';
import RevealText from '../ui/RevealText.astro';

const { hero } = site;
---
<SceneFrame
  name="hero"
  section="hero"
  id="top"
  labelledby="hero-title"
  frame="stage"
  height="fixed"
  pin="tablet"
  length="var(--len-hero)"
  ambient="hero-operatory"
  class="hero"
  stageClass="hero__stage"
>
  <MaskedMedia
    image={hero.image}
    alt={hero.imageAlt}
    sizes="(min-width: 1024px) 91vw, (min-width: 640px) calc(100vw - 48px), calc(100vw - 24px)"
    widths={[768, 1080, 1440, 1920, 2400]}
    priority
    fill
    radius="none"
    positions={{ desktop: '55% 55%', tablet: '44% 62%', mobile: '40% 62%' }}
    class="hero__media"
    attrs={{ 'data-hero-media': '' }}
  />
  <div class="hero__scrim" data-hero-scrim aria-hidden="true"></div>
  <div class="hero__content">
    <RevealText as="h1" id="hero-title" class="hero__title t-hero" lines={hero.titleLines} manual />
    <p class="hero__copy" data-intro>{hero.copy}</p>
    <div class="hero__actions" data-intro>
      <Button href={hero.primary.href} size="sm">{hero.primary.label}</Button>
      <Button href={hero.secondary.href} variant="link" arrowDirection="down">{hero.secondary.label}</Button>
    </div>
  </div>
</SceneFrame>

<style>
  /* stage children are authored here (scoped); the stage itself comes from SceneFrame (global) */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    display: none;
  }
  .hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding: var(--space-5) 4px var(--space-2);
  }
  .hero__title {
    max-width: 13ch;
    font-weight: var(--fw-hero);
    text-wrap: balance;
  }
  .hero__copy {
    max-width: 34ch;
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--text-secondary);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-2);
  }

  /* phones: stage = image only (76svh), text below it, outside the photo */
  @media (max-width: 639.98px) {
    :global(.scene.hero[data-height]) :global(.stage) {
      height: auto;
      background: transparent;
      overflow: visible;
      contain: none;
    }
    :global(.hero .hero__media) {
      position: relative;
      inset: auto;
      height: var(--stage-h);
      border-radius: var(--stage-radius);
    }
  }

  /* load start state (≥640 + motion) in CSS so nothing flashes before hero.ts measures the real window */
  @media (min-width: 640px) and (prefers-reduced-motion: no-preference) {
    :global(html:not(.is-ready) .hero .hero__media) {
      clip-path: inset(28.5% 26% 28.5% 26% round 12px);
    }
    :global(html:not(.is-ready) .hero .hero__media > .mm__inner) {
      transform: scale(0.5);
    }
    :global(html:not(.is-ready)) .hero__scrim {
      opacity: 0;
    }
  }
  :global(.motion-fallback .hero .hero__media) {
    clip-path: none !important;
  }
  :global(.motion-fallback .hero .hero__media > .mm__inner) {
    transform: none !important;
  }

  /* tablet + desktop: text inside the stage, lower-left, over a soft warm scrim */
  @media (min-width: 640px) {
    .hero__scrim {
      display: block;
      background: linear-gradient(0deg, rgba(248, 248, 245, 0.9) 0%, rgba(248, 248, 245, 0.72) 30%, rgba(248, 248, 245, 0.3) 50%, rgba(248, 248, 245, 0) 66%);
    }
    .hero__content {
      position: absolute;
      left: var(--stage-pad-x);
      right: var(--stage-pad-x);
      bottom: var(--stage-pad-y);
      padding: 0;
      gap: var(--space-4);
    }
    .hero__title {
      max-width: 16ch;
    }
  }
  @media (min-width: 1024px) {
    .hero__scrim {
      background:
        linear-gradient(90deg, rgba(248, 248, 245, 0.86) 0%, rgba(248, 248, 245, 0.7) 26%, rgba(248, 248, 245, 0.28) 48%, rgba(248, 248, 245, 0) 64%),
        linear-gradient(0deg, rgba(248, 248, 245, 0.3) 0%, rgba(248, 248, 245, 0) 40%);
    }
    .hero__content {
      right: auto;
      bottom: calc(var(--stage-pad-y) * 1.5);
      width: min(62%, 760px);
      gap: 18px;
    }
    .hero__title {
      max-width: none;
    }
    .hero__copy {
      max-width: 40ch;
    }
    .hero__actions {
      margin-top: var(--space-3);
    }
  }
</style>
