---
/**
 * Header V3: compact central translucent capsule (Services · Process · Our Team · FAQ), wordmark left,
 * one CTA right — aligned to the stage's content column and sitting inside the stage's top band on desktop
 * (--header-top). Hides while scrolling down past the hero, returns on scroll up (header.ts).
 * <1024: wordmark + (CTA ≥640) + Menu → editorial overlay with every destination (site.header.menu).
 */
import { site } from '../../content/site';
import Button from '../ui/Button.astro';
const { nav, menu, cta, menuOpen, menuClose, menuLabel } = site.header;
const { contact, address } = site.footer;
---
<header class="site-header" data-section="header" data-site-header data-intro>
  <div class="site-header__bar">
    <a class="site-header__wordmark" href="#top" aria-label={`${site.name} — back to top`}>{site.wordmark}</a>
    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__capsule">
        {
          nav.map((link) => (
            <li>
              <a href={link.href} data-nav-link>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__actions">
      <Button href={cta.href} size="sm" class="site-header__cta">{cta.label}</Button>
      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-toggle
        data-label-open={menuOpen}
        data-label-close={menuClose}
      >
        <span class="site-header__toggle-label" data-menu-toggle-label>{menuOpen}</span>
        <span class="site-header__toggle-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
  <div class="site-menu" id="site-menu" role="dialog" aria-modal="true" aria-label={menuLabel} data-menu hidden>
    <div class="site-menu__inner container">
      <nav aria-label="Menu">
        <ol class="site-menu__list">
          {
            menu.map((link, i) => (
              <li class="site-menu__item">
                <a class="site-menu__link" href={link.href}>
                  <span class="site-menu__index label">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mask-line">
                    <span class="mask-line__inner" data-menu-line>
                      {link.label}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="site-menu__foot" data-menu-foot>
        <Button href={cta.href}>{cta.label}</Button>
        <div class="site-menu__contact">
          <a class="link-line" href={contact.phone.href}>{contact.phone.label}</a>
          <a class="link-line" href={contact.email.href}>{contact.email.label}</a>
          <span class="t-muted">{address.lines.join(', ')}</span>
        </div>
      </div>
    </div>
  </div>
</header>
<style>
  .site-header {
    position: fixed;
    top: var(--header-top);
    left: 0;
    right: 0;
    z-index: var(--z-header);
    color: var(--color-text);
    pointer-events: none;
    transition:
      transform var(--duration-medium) var(--ease-primary),
      opacity var(--duration-ui) var(--ease-soft);
  }
  .site-header.is-hidden:not(.is-menu-open):not(:focus-within) {
    transform: translate3d(0, -12px, 0);
    opacity: 0;
  }
  .site-header.is-hidden:not(.is-menu-open):not(:focus-within) .site-header__bar {
    pointer-events: none;
  }
  .site-header__bar {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    width: var(--stage-w);
    height: var(--header-h);
    margin-inline: auto;
    padding-inline: 14px 6px;
    border-radius: var(--radius-round);
    background: var(--capsule);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
    border: 1px solid var(--border-hair);
    pointer-events: auto;
  }
  .site-header.is-menu-open .site-header__bar {
    background: transparent;
    border-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .site-header__wordmark {
    justify-self: start;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.22em;
    white-space: nowrap;
    padding-block: 6px;
  }
  .site-header__nav {
    display: none;
  }
  .site-header__capsule {
    display: flex;
    align-items: center;
    height: 36px;
    padding-inline: 6px;
    border-radius: var(--radius-round);
    background: var(--capsule);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
    border: 1px solid var(--border-soft);
  }
  .site-header__capsule a {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding-inline: 12px;
    border-radius: var(--radius-round);
    font-size: 0.78125rem; /* 12.5 */
    font-weight: var(--fw-medium);
    letter-spacing: 0.005em;
    color: var(--text-secondary);
    transition:
      color var(--duration-ui) var(--ease-primary),
      background-color var(--duration-ui) var(--ease-primary);
  }
  .site-header__capsule a:hover,
  .site-header__capsule a[aria-current='true'] {
    color: var(--text-primary);
  }
  .site-header__capsule a[aria-current='true'] {
    background: rgba(20, 20, 20, 0.05);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }
  .site-header__actions :global(.site-header__cta) {
    display: none;
  }
  /* toggle */
  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 42px;
    padding: 0 4px 0 12px;
    font-size: var(--fs-button);
    font-weight: var(--fw-medium);
  }
  .site-header__toggle-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
    transition: transform var(--duration-fast) var(--ease-primary);
  }
  .site-header__toggle:hover .site-header__toggle-icon {
    transform: scale(1.08);
  }
  .site-header__toggle-icon span {
    position: absolute;
    width: 12px;
    height: 1.4px;
    background: currentColor;
    transition: transform var(--duration-ui) var(--ease-primary);
  }
  .site-header__toggle-icon span:first-child {
    transform: translateY(-2.5px);
  }
  .site-header__toggle-icon span:last-child {
    transform: translateY(2.5px);
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-icon span:first-child {
    transform: rotate(45deg);
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-icon span:last-child {
    transform: rotate(-45deg);
  }

  @media (min-width: 640px) {
    .site-header__actions :global(.site-header__cta) {
      display: inline-flex;
    }
  }
  @media (min-width: 1024px) {
    /* desktop: no bar surface — wordmark and CTA float on the stage, the capsule carries the nav */
    .site-header__bar {
      grid-template-columns: 1fr auto 1fr;
      padding-inline: var(--stage-pad-x);
      border: 0;
      border-radius: 0;
      background: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      pointer-events: none;
    }
    .site-header__bar > * {
      pointer-events: auto;
    }
    .site-header__nav {
      display: block;
    }
    .site-header__toggle {
      display: none;
    }
  }
  /* ---- mobile editorial menu overlay ---- */
  .site-menu {
    position: fixed;
    inset: 0;
    pointer-events: auto;
    z-index: 1;
    background: var(--color-bg-alt);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .site-menu__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-8);
    min-height: 100%;
    padding-top: calc(var(--header-top) + var(--header-h) + var(--space-6));
    padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom));
    border-top: 1px solid transparent;
  }
  .site-menu__list {
    border-top: 1px solid var(--color-border);
  }
  .site-menu__item {
    border-bottom: 1px solid var(--color-border);
  }
  .site-menu__link {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    align-items: baseline;
    padding-block: 14px 12px;
    font-size: clamp(2rem, 1.4rem + 3vw, 3rem);
    font-weight: var(--fw-display);
    letter-spacing: var(--ls-heading);
    line-height: 1.05;
  }
  .site-menu__index {
    align-self: center;
  }
  .site-menu__foot {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .site-menu__contact {
    display: grid;
    gap: 6px;
    font-size: var(--fs-small);
  }
  @media (min-width: 1024px) {
    .site-menu {
      display: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header__toggle-icon,
    .site-header__toggle-icon span {
      transition: none;
    }
  }
</style>
