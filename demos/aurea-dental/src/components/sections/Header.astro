---
import { site } from '../../content/site';
import Button from '../ui/Button.astro';

const { nav, cta, menuOpen, menuClose, menuLabel } = site.header;
const { contact, address } = site.footer;
---
<header class="site-header" data-section="header" data-site-header data-intro data-solid-from="#about">
  <div class="site-header__bar container">
    <a class="site-header__wordmark" href="#top" aria-label={`${site.name} — back to top`}>{site.wordmark}</a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {
          nav.map((link) => (
            <li>
              <a class="link-line" href={link.href} data-nav-link>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button href={cta.href} size="sm" class="site-header__cta">{cta.label}</Button>
      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-toggle
        data-label-open={menuOpen}
        data-label-close={menuClose}
      >
        <span class="site-header__toggle-label" data-menu-toggle-label>{menuOpen}</span>
        <span class="site-header__toggle-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="site-menu" id="site-menu" role="dialog" aria-modal="true" aria-label={menuLabel} data-menu hidden>
    <div class="site-menu__inner container">
      <nav aria-label="Menu">
        <ol class="site-menu__list">
          {
            nav.map((link, i) => (
              <li class="site-menu__item">
                <a class="site-menu__link" href={link.href}>
                  <span class="site-menu__index label">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mask-line">
                    <span class="mask-line__inner" data-menu-line>
                      {link.label}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="site-menu__foot" data-menu-foot>
        <Button href={cta.href}>{cta.label}</Button>
        <div class="site-menu__contact">
          <a class="link-line" href={contact.phone.href}>{contact.phone.label}</a>
          <a class="link-line" href={contact.email.href}>{contact.email.label}</a>
          <span class="t-muted">{address.lines.join(', ')}</span>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    color: var(--color-text);
  }
  /* solid layer: fades in past the hero (no shadow) */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: var(--header-h);
    background: var(--color-header);
    -webkit-backdrop-filter: blur(18px) saturate(1.1);
    backdrop-filter: blur(18px) saturate(1.1);
    border-bottom: 1px solid var(--color-border-soft);
    opacity: 0;
    transition: opacity var(--duration-ui) var(--ease-primary);
    pointer-events: none;
  }
  .site-header.is-solid::before {
    opacity: 1;
  }
  .site-header.is-menu-open::before {
    opacity: 0;
  }

  .site-header__bar {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    height: var(--header-h);
  }
  .site-header__wordmark {
    justify-self: start;
    font-size: 0.8125rem;
    font-weight: 560;
    letter-spacing: 0.2em;
    white-space: nowrap;
    padding-block: 6px;
  }
  .site-header__nav {
    display: none;
  }
  .site-header__nav ul {
    display: flex;
    gap: clamp(20px, 2.2vw, 36px);
  }
  .site-header__nav a {
    font-size: var(--fs-button);
    font-weight: var(--fw-medium);
    letter-spacing: 0.01em;
    color: var(--color-text-2);
    transition: color var(--duration-ui) var(--ease-primary);
  }
  .site-header__nav a:hover,
  .site-header__nav a[aria-current='true'] {
    color: var(--color-text);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
  }
  .site-header__actions :global(.site-header__cta) {
    display: none;
  }

  /* toggle */
  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 42px;
    padding: 0 4px 0 12px;
    font-size: var(--fs-button);
    font-weight: var(--fw-medium);
  }
  .site-header__toggle-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
    transition: transform var(--duration-fast) var(--ease-primary);
  }
  .site-header__toggle:hover .site-header__toggle-icon {
    transform: scale(1.08);
  }
  .site-header__toggle-icon span {
    position: absolute;
    width: 12px;
    height: 1.4px;
    background: currentColor;
    transition: transform var(--duration-ui) var(--ease-primary);
  }
  .site-header__toggle-icon span:first-child {
    transform: translateY(-2.5px);
  }
  .site-header__toggle-icon span:last-child {
    transform: translateY(2.5px);
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-icon span:first-child {
    transform: rotate(45deg);
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-icon span:last-child {
    transform: rotate(-45deg);
  }

  @media (min-width: 640px) {
    .site-header__actions :global(.site-header__cta) {
      display: inline-flex;
    }
  }
  @media (min-width: 1024px) {
    .site-header__bar {
      grid-template-columns: 1fr auto 1fr;
    }
    .site-header__nav {
      display: block;
    }
    .site-header__toggle {
      display: none;
    }
  }

  /* ---- mobile editorial menu overlay ---- */
  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: var(--color-bg-alt);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .site-menu__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-8);
    min-height: 100%;
    padding-top: calc(var(--header-h) + var(--space-6));
    padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom));
    border-top: 1px solid transparent;
  }
  .site-menu__list {
    border-top: 1px solid var(--color-border);
  }
  .site-menu__item {
    border-bottom: 1px solid var(--color-border);
  }
  .site-menu__link {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    align-items: baseline;
    padding-block: 14px 12px;
    font-size: clamp(2rem, 1.4rem + 3vw, 3rem);
    font-weight: var(--fw-display);
    letter-spacing: var(--ls-heading);
    line-height: 1.05;
  }
  .site-menu__index {
    align-self: center;
  }
  .site-menu__foot {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .site-menu__contact {
    display: grid;
    gap: 6px;
    font-size: var(--fs-small);
  }
  @media (min-width: 1024px) {
    .site-menu {
      display: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header::before,
    .site-header__toggle-icon,
    .site-header__toggle-icon span {
      transition: none;
    }
  }
</style>
