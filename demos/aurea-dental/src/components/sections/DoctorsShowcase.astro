---
/**
 * §7 DoctorsShowcase — the HUMAN scene (motion kit §4 #5, §5 Doctors).
 *
 * <RisingPanel frame="stage" height="stage" length="var(--len-doctors)">: an inset stage that rises over the still
 * pinned Journey (scenes.ts: journey stage .955 / −2 % / dim .10), holds for --len-doctors (a breath), then lifts
 * off Results (which lies beneath). Ambient follows the selected doctor (data-ambient + ambientChanged()).
 *
 * Composition (≥640): each doctor is ONE MaskedMedia layer = blurred self-backdrop (the portrait's own clinic
 * colour, low-res) + the real 4:5 portrait composed centre-right with feathered edges. Claim upper-left, bio
 * upper-right, avatar tablist bottom-left, name · specialty · count on the bottom row, text over a dark scrim.
 * Switch = maskWipe() (directional clip-path, 650 ms) + name/specialty/bio y 8 → 0 + opacity.
 * Phone: portrait-first 4:5 card on a light stage, text + selector below (wipe kept).
 */
import { site } from '../../content/site';
import RisingPanel from '../scene/RisingPanel.astro';
import MaskedMedia from '../scene/MaskedMedia.astro';
import Img from '../ui/Img.astro';

const data = site.doctors;
const total = String(data.items.length).padStart(2, '0');
const first = data.items[0]!;
---
<RisingPanel
  name="doctors"
  section="doctors"
  id="team"
  labelledby="team-title"
  frame="stage"
  height="stage"
  length="var(--len-doctors)"
  tone="photo"
  ambient={first.image}
  class="doctors"
  stageClass="doctors__stage"
>
  <div class="doctors__panel" id="doctors-panel" role="tabpanel" aria-labelledby={`doctor-tab-${first.id}`} data-doctors-panel>
    <div class="doctors__media">
      {
        data.items.map((d, i) => (
          <MaskedMedia
            image={d.image}
            alt=""
            sizes="320px"
            widths={[320]}
            quality={40}
            fill
            radius="none"
            class={i === 0 ? 'dlayer is-active' : 'dlayer'}
            attrs={i === 0 ? { 'data-dlayer': d.image } : { 'data-dlayer': d.image, 'aria-hidden': 'true' }}
          >
            <div class="dlayer__portrait">
              <Img
                image={d.image}
                alt={d.imageAlt}
                sizes="(min-width: 1024px) 520px, (min-width: 640px) 540px, 92vw"
                widths={[480, 640, 960]}
                cover
                position={data.focus[d.id]}
              />
            </div>
          </MaskedMedia>
        ))
      }
      <div class="doctors__scrim" aria-hidden="true"></div>
    </div>

    {
      data.items.map((d, i) => (
        <div class="dinfo" data-dinfo hidden={i !== 0}>
          <h3 class="dinfo__name" data-dinfo-part>{d.name}</h3>
          <p class="dinfo__spec" data-dinfo-part>{d.specialty}</p>
          <p class="dinfo__bio" data-dinfo-part>{d.bio}</p>
        </div>
      ))
    }
  </div>

  <header class="doctors__head">
    <p class="label doctors__label">{data.label}</p>
    <h2 id="team-title" class="doctors__claim">
      {data.titleLines.map((line, i) => <span class="doctors__claim-line">{line}{i < data.titleLines.length - 1 ? ' ' : ''}</span>)}
    </h2>
  </header>

  <div class="doctors__select">
    <p class="visually-hidden" id="doctors-select-label">{data.selectorLabel}</p>
    <div class="doctors__tabs" role="tablist" aria-labelledby="doctors-select-label" data-doctors-tabs>
      {
        data.items.map((d, i) => (
          <button
            type="button"
            class="dtab"
            role="tab"
            id={`doctor-tab-${d.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls="doctors-panel"
            tabindex={i === 0 ? 0 : -1}
            data-doctor-tab
          >
            <span class="dtab__avatar" aria-hidden="true">
              <Img image={d.image} alt="" sizes="40px" widths={[120]} quality={60} cover position={data.focus[d.id]} />
            </span>
            <span class="visually-hidden">{d.name}, {d.specialty}</span>
          </button>
        ))
      }
    </div>
  </div>

  <p class="doctors__count" aria-hidden="true"><span data-doctors-current>01</span> / {total}</p>
</RisingPanel>

<style is:global>
  /* pairs with .journey's tail (TreatmentJourney.astro): the journey stays pinned beneath this stage for the whole
     doctors breath, so the overlap into the journey scene is the rise overlap + --len-doctors */
  .scene.doctors[data-enter='rise'] {
    margin-top: calc(-1 * (var(--jd-overlap) + var(--len-doctors))); /* --jd-overlap: TreatmentJourney.astro */
  }

  /* ================================================================ phone: portrait-first card on a light stage */
  .doctors .doctors__stage {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--stage-pad-y) var(--stage-pad-x);
    background: var(--surface);
    color: var(--text-primary);
  }
  .doctors__head {
    order: 1;
    display: grid;
    gap: var(--space-3);
  }
  .doctors__claim {
    font-size: var(--fs-h3);
    font-weight: var(--fw-display);
    line-height: 1.06;
    letter-spacing: var(--ls-heading);
    text-wrap: balance;
  }
  .doctors__claim-line {
    display: block;
  }
  .doctors__panel {
    order: 2;
    display: grid;
    gap: var(--space-2);
  }
  .doctors__media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--media-radius);
    overflow: hidden;
    background: var(--surface-muted);
    isolation: isolate;
    margin-bottom: var(--space-3);
  }
  .dlayer:not(.is-active) {
    clip-path: inset(0% 0% 0% 100%);
  }
  .dlayer > .mm__inner {
    display: none; /* phones: no self-backdrop, the portrait fills the card */
  }
  .dlayer__portrait {
    position: absolute;
    inset: 0;
  }
  .dlayer__portrait .picture {
    height: 100%;
  }
  .doctors__scrim {
    display: none;
  }
  .dinfo {
    display: contents;
  }
  .dinfo[hidden] {
    display: none;
  }
  .dinfo__name {
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-tight);
    line-height: var(--lh-snug);
  }
  .dinfo__spec {
    font-size: var(--fs-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .dinfo__bio {
    max-width: 34ch;
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .doctors__select {
    order: 3;
  }
  .doctors__tabs {
    display: flex;
    gap: 12px;
    padding-top: 8px; /* room for the active dot */
  }
  .dtab {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }
  .dtab__avatar {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: var(--surface-muted);
    opacity: 0.7;
    transition:
      opacity var(--duration-ui) var(--ease-soft),
      box-shadow var(--duration-ui) var(--ease-soft);
  }
  .dtab__avatar .picture {
    height: 100%;
  }
  .dtab__avatar img {
    transform: scale(1.5);
    transform-origin: 50% 32%;
  }
  .dtab::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -9px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    transition: opacity var(--duration-ui) var(--ease-soft);
  }
  .dtab[aria-selected='true']::before {
    opacity: 1;
  }
  .dtab[aria-selected='true'] .dtab__avatar,
  .dtab:hover .dtab__avatar {
    opacity: 1;
  }
  .dtab[aria-selected='true'] .dtab__avatar {
    box-shadow:
      0 0 0 2px var(--surface),
      0 0 0 3px currentColor;
  }
  .dtab:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
  }
  .doctors__count {
    display: none;
  }

  /* ================================================================ ≥640: the wide landscape stage */
  @media (min-width: 640px) {
    .doctors .doctors__stage {
      display: block;
      padding: 0;
      background: var(--scene-surface);
      color: var(--white);
    }
    .doctors__panel,
    .doctors__media {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
      border-radius: 0;
      margin: 0;
    }
    .doctors__media {
      z-index: 0;
    }
    /* blurred self-backdrop: the portrait's own clinic colour fills the landscape stage */
    .dlayer > .mm__inner {
      display: block;
      filter: blur(26px) saturate(0.85) brightness(0.93);
      transform: scale(1.12);
      will-change: transform;
    }
    .dlayer__portrait {
      left: 57%;
      right: auto;
      width: calc(var(--stage-h) * 0.8);
      translate: -50% 0;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
    }
    .doctors__scrim {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 3;
      pointer-events: none;
      background:
        linear-gradient(90deg, var(--scrim-dark) 0%, rgba(17, 17, 17, 0) 44%),
        linear-gradient(270deg, rgba(17, 17, 17, 0.26) 0%, rgba(17, 17, 17, 0) 30%),
        linear-gradient(0deg, rgba(17, 17, 17, 0.32) 0%, rgba(17, 17, 17, 0) 32%);
    }
    .doctors__head,
    .dinfo > *,
    .doctors__select,
    .doctors__count {
      position: absolute;
      z-index: 4;
    }
    .doctors__head {
      top: var(--stage-pad-y);
      left: var(--stage-pad-x);
      max-width: 22rem;
    }
    .doctors__label {
      color: rgba(255, 255, 255, 0.78);
    }
    .doctors__claim {
      color: var(--white);
    }
    .dinfo__name {
      left: var(--stage-pad-x);
      bottom: var(--stage-pad-y);
      font-size: var(--fs-small);
      font-weight: var(--fw-medium);
      letter-spacing: 0;
      line-height: 1.2;
    }
    .dinfo__spec {
      left: 50%;
      bottom: var(--stage-pad-y);
      translate: -50% 0;
      line-height: 1.4;
      white-space: nowrap;
      color: rgba(255, 255, 255, 0.82);
    }
    .dinfo__bio {
      right: var(--stage-pad-x);
      bottom: calc(var(--stage-pad-y) + 2.5rem);
      width: 28ch;
      font-size: var(--fs-small);
      line-height: 1.5;
      color: rgba(255, 255, 255, 0.9);
    }
    .doctors__select {
      left: var(--stage-pad-x);
      bottom: calc(var(--stage-pad-y) + 2.25rem);
      color: var(--white);
    }
    .dtab[aria-selected='true'] .dtab__avatar {
      box-shadow:
        0 0 0 2px rgba(17, 17, 17, 0.25),
        0 0 0 3px var(--white);
    }
    .doctors__count {
      display: block;
      right: var(--stage-pad-x);
      bottom: var(--stage-pad-y);
      font-size: var(--fs-label);
      font-weight: var(--fw-medium);
      letter-spacing: var(--ls-label);
      line-height: 1.4;
      font-variant-numeric: tabular-nums;
      color: rgba(255, 255, 255, 0.82);
    }
  }

  @media (min-width: 1024px) {
    .dlayer__portrait {
      left: 55%;
    }
    .doctors__head {
      max-width: 26rem;
    }
    .dinfo__bio {
      top: var(--stage-pad-y);
      bottom: auto;
      width: 30ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dtab__avatar,
    .dtab::before {
      transition-duration: 1ms;
    }
  }
</style>
