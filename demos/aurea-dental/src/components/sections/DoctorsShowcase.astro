---
import { site } from '../../content/site';
import SceneFrame from '../scene/SceneFrame.astro';
import Img from '../ui/Img.astro';
const data = site.doctors;
const first = data.items[0]!;
---
<SceneFrame name="doctors" section="doctors" id="team" labelledby="team-title" class="doctors" stageClass="doctors__stage">
  <header class="doctors__head"><p class="label">Our team</p><h2 id="team-title" class="t-h2">Meet the people<br />behind your care.</h2></header>
  <div class="doctors__panel" id="doctors-panel" role="tabpanel" aria-labelledby={`doctor-tab-${first.id}`} data-doctors-panel>
    <div class="doctors__portraits">
      {data.items.map((d,i)=><div class:list={['dlayer',{'is-active':i===0}]} data-dlayer={d.image} aria-hidden={i===0?undefined:'true'}><div class="dlayer__portrait"><Img image={d.image} alt={d.imageAlt} sizes="(min-width:1024px) 440px, 90vw" widths={[480,640,960]} cover position={data.focus[d.id]} /></div></div>)}
    </div>
    <div class="doctors__details">
      {data.items.map((d,i)=><div class="dinfo" data-dinfo hidden={i!==0}><h3 data-dinfo-part>{d.name}</h3><p class="dinfo__specialty" data-dinfo-part>{d.specialty}</p><p class="dinfo__biography" data-dinfo-part>{d.bio}</p></div>)}
    </div>
  </div>
  <div class="doctors__tabs" role="tablist" aria-label={data.selectorLabel} data-doctors-tabs>{data.items.map((d,i)=><button role="tab" type="button" id={`doctor-tab-${d.id}`} aria-selected={i===0?'true':'false'} aria-controls="doctors-panel" tabindex={i===0?0:-1} data-doctor-tab>{d.name}</button>)}</div>
</SceneFrame>
<style is:global>
  .scene.doctors .doctors__stage { height: auto; padding: var(--stage-pad-y) var(--stage-pad-x); background: var(--surface); }
  .doctors__head { display: grid; gap: 20px; margin-bottom: 40px; }
  .doctors__panel { display: grid; grid-template-columns: .85fr 1.15fr; gap: 64px; align-items: center; }
  .doctors__portraits { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--surface-muted); }
  .doctors .dlayer { position: absolute; inset: 0; clip-path: inset(0 0 0 100%); z-index: 0; }
  .doctors .dlayer.is-active { clip-path: inset(0); z-index: 2; }
  .dlayer__portrait, .dlayer__portrait .picture, .dlayer__portrait .img { width: 100%; height: 100%; }
  .doctors__details { display: grid; }
  .doctors .dinfo { grid-area: 1 / 1; }
  .doctors .dinfo h3 { font: 400 clamp(28px,2.7vw,40px)/1.15 var(--font-display); }
  .dinfo__specialty { color: var(--text-secondary); margin-top: 12px; font-size: 17px; }
  .dinfo__biography { color: var(--text-secondary); margin-top: 32px; max-width: 32ch; font-size: var(--fs-body-lg); }
  .doctors__tabs { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; border-top: 1px solid var(--border-soft); padding-top: 24px; }
  .doctors__tabs button { padding: 12px 18px; border: 1px solid var(--border-soft); border-radius: 4px; font-size: 15px; color: var(--text-secondary); }
  .doctors__tabs button[aria-selected='true'] { background: var(--text-primary); color: var(--white); border-color: var(--text-primary); }
  @media(max-width:1023.98px) { .doctors__panel { grid-template-columns: 1fr; gap: 28px; } .doctors__portraits { max-width: 480px; width: 100%; } .doctors__head { margin-bottom: 28px; } .dinfo__biography { margin-top: 20px; } }
</style>
