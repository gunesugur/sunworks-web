---
/**
 * §11 ResultsSection. 55/45: before/after comparison left, testimonial right; a heavily blurred,
 * low-opacity enlargement of the result sits behind. Continues the Doctors panel surface so the
 * portrait → comparison wipe reads as one cut. Mobile: stacked.
 */
import { site } from '../../content/site';
import Img from '../ui/Img.astro';
import RevealText from '../ui/RevealText.astro';
import BeforeAfterSlider from './results/BeforeAfterSlider.astro';
import TestimonialCard from './results/TestimonialCard.astro';

const data = site.results;
const t = data.testimonial;
---
<section class="results" id="results" data-section="results" aria-labelledby="results-title">
  <div class="results__depth" data-results-depth aria-hidden="true">
    <Img image={data.slider.after} alt="" sizes="50vw" widths={[480, 768]} cover quality={40} />
  </div>

  <div class="results__inner container">
    <header class="results__head">
      <p class="label label--dark" data-reveal="fade">{data.label}</p>
      <RevealText as="h2" id="results-title" class="t-h2" lines={data.titleLines} />
    </header>

    <div class="results__grid">
      <div class="results__compare">
        <BeforeAfterSlider {...data.slider} caption={t.treatment} />
      </div>
      <div class="results__story">
        <TestimonialCard {...t} />
      </div>
    </div>
  </div>
</section>

<style>
  .results {
    position: relative;
    background: var(--color-panel);
    padding-block: var(--section-pad-sm) var(--section-pad);
    overflow: clip;
    isolation: isolate;
  }
  .results__depth {
    position: absolute;
    z-index: -1;
    top: 30%;
    left: 2%;
    width: 52%;
    height: 56%;
    opacity: 0.14;
    filter: blur(80px);
    transform: scale(1.3);
    pointer-events: none;
  }
  .results__depth :global(.picture) {
    height: 100%;
  }
  .results__inner {
    display: grid;
    gap: var(--space-7);
  }
  .results__head {
    display: grid;
    gap: var(--space-5);
  }
  .results__grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .results__inner {
      gap: clamp(48px, 5vw, 88px);
    }
    .results__grid {
      grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
      column-gap: 0;
      align-items: end;
    }
    .results__story {
      padding-left: clamp(40px, 6vw, 120px);
      padding-bottom: calc(var(--space-4) + 1.3em);
    }
  }
</style>
