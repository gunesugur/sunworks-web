---
/**
 * Patient testimonial — editorial block, not a boxed card. Identity is a privacy-safe placeholder:
 * a neutral monogram disc, age and treatment only (real details only with written consent).
 */
interface Props {
  label: string;
  quote: string;
  body: string;
  patient: string;
  treatment: string;
  note: string;
  monogram: string;
}
const { label, quote, body, patient, treatment, note, monogram } = Astro.props;
---
<figure class="testimonial" data-testimonial>
  <p class="label testimonial__label">{label}</p>
  <blockquote class="testimonial__quote">
    <p class="testimonial__lead" data-testimonial-lead>“{quote}”</p>
    <p class="testimonial__body" data-testimonial-body>{body}</p>
  </blockquote>
  <figcaption class="testimonial__meta" data-testimonial-meta>
    <span class="testimonial__avatar" aria-hidden="true">{monogram}</span>
    <span class="testimonial__who">
      <span class="testimonial__name">{patient}</span>
      <span class="testimonial__treat">{treatment}</span>
    </span>
    <span class="testimonial__note">{note}</span>
  </figcaption>
</figure>

<style>
  .testimonial {
    display: grid;
    gap: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .testimonial__quote {
    display: grid;
    gap: var(--space-5);
  }
  .testimonial__lead {
    font-size: var(--fs-statement);
    font-weight: var(--fw-book);
    line-height: 1.08;
    letter-spacing: var(--ls-heading);
    text-indent: -0.42em;
    text-wrap: balance;
  }
  .testimonial__body {
    max-width: 28rem;
    font-size: var(--fs-body-lg);
    color: var(--color-text-2);
  }
  .testimonial__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: var(--space-4);
    row-gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .testimonial__avatar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--color-text-2);
  }
  .testimonial__who {
    display: grid;
    gap: 2px;
    line-height: 1.3;
  }
  .testimonial__name {
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }
  .testimonial__treat {
    font-size: var(--fs-small);
    color: var(--color-text-2);
  }
  .testimonial__note {
    grid-column: 1 / -1;
    font-size: 0.75rem;
    color: var(--color-text-2);
  }
</style>
