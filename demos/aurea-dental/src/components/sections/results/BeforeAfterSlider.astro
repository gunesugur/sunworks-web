---
/**
 * Registered before/after comparison (1:1). Both layers are absolutely stacked in ONE box with identical
 * sizes/widths/object-position, so they decode to the same pixels (no drift). `--pos` (0–100) is the only thing
 * that changes: before layer clip-path + divider rail transform — no layout, no CLS.
 * 1 px white divider, 36 px dark handle (the ARIA slider: ←/→ 2 %, Shift or PageUp/PageDown 10 %, Home/End),
 * tiny BEFORE / AFTER pills. Pointer drag anywhere on the frame (results.ts). Without JS it rests at 50 %.
 */
import type { ImageKey } from '../../../lib/images';
import Img from '../../ui/Img.astro';

interface Props {
  before: ImageKey;
  after: ImageKey;
  beforeAlt: string;
  afterAlt: string;
  beforeLabel: string;
  afterLabel: string;
  ariaLabel: string;
  valueText: string;
  hint: string;
}
const { before, after, beforeAlt, afterAlt, beforeLabel, afterLabel, ariaLabel, valueText, hint } = Astro.props;
const initial = 50;
const text = valueText.replace('{before}', String(initial)).replace('{after}', String(100 - initial));
const sizes = '(min-width: 1024px) 500px, (min-width: 640px) 45vw, 92vw';
const widths = [480, 768, 1080];
---
<figure class="ba" data-ba data-value-text={valueText}>
  <div class="ba__frame" data-ba-frame style={`--pos: ${initial}`}>
    <div class="ba__layer">
      <Img image={after} alt={afterAlt} sizes={sizes} widths={widths} cover position="50% 50%" />
    </div>
    <div class="ba__layer ba__layer--before">
      <Img image={before} alt={beforeAlt} sizes={sizes} widths={widths} cover position="50% 50%" />
    </div>
    <span class="ba__tag ba__tag--before" aria-hidden="true">{beforeLabel}</span>
    <span class="ba__tag ba__tag--after" aria-hidden="true">{afterLabel}</span>
    <div class="ba__rail">
      <span class="ba__line" aria-hidden="true"></span>
      <span
        class="ba__handle"
        role="slider"
        tabindex="0"
        aria-label={ariaLabel}
        aria-describedby="ba-hint"
        aria-orientation="horizontal"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow={initial}
        aria-valuetext={text}
        data-ba-handle
      >
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
          <path d="M5.5 4.5 2 8l3.5 3.5M10.5 4.5 14 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </div>
  <figcaption class="visually-hidden" id="ba-hint">{hint}</figcaption>
</figure>

<style is:global>
  .ba {
    margin: 0;
  }
  .ba__frame {
    --pos: 50;
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-muted);
    touch-action: pan-y;
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
    isolation: isolate;
  }
  .ba__layer {
    position: absolute;
    inset: 0;
  }
  .ba__layer .picture {
    height: 100%;
  }
  .ba__layer img {
    pointer-events: none;
    -webkit-user-drag: none;
  }
  .ba__layer--before {
    clip-path: inset(0 calc(100% - var(--pos) * 1%) 0 0);
  }
  .ba__tag {
    position: absolute;
    top: 14px;
    z-index: 2;
    padding: 4px 8px 3px;
    border-radius: var(--radius-round);
    background: rgba(17, 17, 17, 0.45);
    font-size: 0.625rem;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--white);
    pointer-events: none;
  }
  .ba__tag--before {
    left: 14px;
  }
  .ba__tag--after {
    right: 14px;
  }
  /* full-size rail translated by --pos %: divider + handle ride on its left edge */
  .ba__rail {
    position: absolute;
    inset: 0;
    z-index: 3;
    transform: translate3d(calc(var(--pos) * 1%), 0, 0);
    pointer-events: none;
  }
  .ba__line {
    position: absolute;
    inset: 0 auto 0 -0.5px;
    width: 1px;
    background: var(--white);
  }
  .ba__handle {
    position: absolute;
    top: 50%;
    left: 0;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin: -18px 0 0 -18px;
    border-radius: 50%;
    background: var(--black);
    color: var(--white);
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
    transition: transform var(--duration-fast) var(--ease-primary);
  }
  .ba__frame:hover .ba__handle,
  .ba__frame.is-dragging .ba__handle {
    transform: scale(1.06);
  }
  .ba__frame.is-dragging .ba__handle {
    cursor: grabbing;
  }
  .ba__handle:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .ba__handle {
      transition: none;
    }
  }
</style>
