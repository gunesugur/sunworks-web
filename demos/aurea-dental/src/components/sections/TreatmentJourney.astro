---
import { site } from '../../content/site';
import SceneFrame from '../scene/SceneFrame.astro';
import Img from '../ui/Img.astro';
const data = site.journey;
---
<SceneFrame name="journey" id="journey" labelledby="journey-title" class="journey" stageClass="journey__stage">
  <header class="journey__head"><p class="label">Your treatment</p><h2 id="journey-title" class="t-h2">{data.titleLines.join(' ')}</h2><p>Know what happens next, before you begin.</p></header>
  <ol class="journey__steps">{data.steps.map(s => <li><span class="journey__number">{s.index}</span><Img image={s.image} alt={s.imageAlt} widths={[240,480]} sizes="140px" /><h3>{s.title}</h3><p>{s.caption}</p></li>)}</ol>
</SceneFrame>
<style is:global>
  .scene.journey .journey__stage { height: auto; padding: var(--stage-pad-y) var(--stage-pad-x); background: var(--surface-muted); }
  .journey__head { display: grid; gap: 20px; max-width: 38rem; margin-bottom: 48px; }
  .journey__head > p:last-child { color: var(--text-secondary); }
  .journey__steps { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 28px; }
  .journey__steps li { border-top: 1px solid var(--border-soft); padding-top: 20px; display: flex; flex-direction: column; gap: 16px; }
  .journey__number { color: var(--text-secondary); font-size: 16px; }
  .journey__steps .picture { width: 120px; height: 120px; align-self: center; }
  .journey__steps .img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .journey__steps h3 { font: 500 20px/1.25 var(--font-sans); }
  .journey__steps p { font-size: 16px; color: var(--text-secondary); }
  @media(max-width:1023.98px) { .journey__steps { grid-template-columns: 1fr; gap: 28px; } .journey__steps li { display: grid; grid-template-columns: 36px 88px 1fr; gap: 12px 16px; align-items: start; } .journey__steps .picture { width: 88px; height: 88px; grid-row: span 2; } .journey__steps p { grid-column: 3; } .journey__steps h3 { grid-column: 3; } }
  @media(max-width:399px) { .journey__steps li { grid-template-columns: 28px 64px 1fr; gap: 10px; } .journey__steps .picture { width:64px; height:64px; } }
</style>
