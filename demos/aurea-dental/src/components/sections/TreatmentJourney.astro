---
/**
 * §6 TreatmentJourney — ONE stable pinned stage (motion kit §4 #4, §5 Journey).
 *
 * <SceneFrame enter="beneath" pin="all" height="fixed" length="var(--len-journey)">: the stage settles
 * (.965 → 1) while the Services panel lifts off it (scenes.ts), then journey.ts scrubs its own state machine
 * over --len-journey via scenePin(): the heading lifts out of the stage top (first 14 %), then 5 states /
 * 4 transitions — masked number roll, model swap (brief values, no spin/float), step list shift, caption swap,
 * thin progress line. The stage itself never moves. Doctors (RisingPanel) rises over it afterwards.
 *
 * Desktop: number left (cols 1–2) · model 1:1 + caption (cols 3–7) · step list (cols 9–12) · progress far right.
 * Tablet / phone: number top-left · model centre · the list collapses to ONE swapping row · caption below.
 * Reduced motion (and motion-fallback): no pin, stacked list with all 5 steps (number · model · title · caption).
 */
import { site } from '../../content/site';
import SceneFrame from '../scene/SceneFrame.astro';
import Img from '../ui/Img.astro';

const data = site.journey;
const total = String(data.steps.length).padStart(2, '0');
---
<SceneFrame
  name="journey"
  section="journey"
  id="journey"
  labelledby="journey-title"
  frame="stage"
  height="fixed"
  pin="all"
  length="var(--len-journey)"
  enter="beneath"
  tone="muted"
  class="journey"
  stageClass="journey__stage"
>
  <div class="journey__track" data-journey-track>
    <header class="journey__head" data-journey-head>
      <p class="label label--dark">{data.label}</p>
      <h2 id="journey-title" class="journey__title t-h2">
        {data.titleLines.map((line, i) => <span class="journey__title-line">{line}{i < data.titleLines.length - 1 ? ' ' : ''}</span>)}
      </h2>
    </header>

    <div class="journey__body">
      <p class="jcount" aria-hidden="true">
        <span class="jcount__mask">
          {data.steps.map((s, i) => <span class="jnum" data-jnum style={`--i: ${i + 1}`}>{s.index}</span>)}
        </span>
        <span class="jcount__total">/ {total}</span>
      </p>

      <div class="jmodels">
        <div class="jframe">
          {
            data.steps.map((s, i) => (
              <figure class="jmodel" data-jmodel style={`--i: ${i + 1}`}>
                <Img image={s.image} alt={s.imageAlt} sizes="(min-width: 1024px) 440px, (min-width: 640px) 460px, 88vw" widths={[480, 768, 960]} cover position="50% 55%" />
              </figure>
            ))
          }
        </div>
        <div class="jcaps" aria-hidden="true">
          {data.steps.map((s) => <p class="jcap" data-jcap>{s.caption}</p>)}
        </div>
      </div>

      <div class="jlist">
        <p class="label jlist__label" aria-hidden="true">{data.listLabel}</p>
        <div class="jlist__view">
          <ol class="jsteps" data-jsteps>
            {
              data.steps.map((s, i) => (
                <li class="jstep" data-jstep aria-current={i === 0 ? 'step' : undefined} style={`--i: ${i + 1}`}>
                  <span class="jstep__row" data-jrow>
                    <span class="jstep__index" aria-hidden="true">{s.index}</span>
                    <h3 class="jstep__title">
                      <span class="visually-hidden">{data.stepLabel} {s.index}: </span>
                      {s.title}
                    </h3>
                  </span>
                  <p class="jstep__caption">{s.caption}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <div class="jprogress" aria-hidden="true"><span data-jprogress></span></div>
    </div>
  </div>
</SceneFrame>

<style is:global>
  /* The journey stays pinned beneath the Doctors stage for its breath too (tail = rise overlap + --len-doctors),
     so the covered journey never slides into view above the inset doctors stage (motion kit §4 #5 note). */
  .scene.journey.scene--stage[data-scene],
  .scene.doctors {
    --jd-overlap: var(--overlap-rise); /* phones / reduced motion: 0 */
  }
  @media (min-width: 640px) and (prefers-reduced-motion: no-preference) {
    .scene.journey.scene--stage[data-scene],
    .scene.doctors {
      --jd-overlap: 100svh; /* tablet too: the journey must still be pinned when the doctors stage has covered it */
    }
  }
  .scene.journey.scene--stage[data-scene] {
    --scene-tail: calc(var(--jd-overlap) + var(--len-doctors));
  }

  /* ================================================================ static (reduced motion / fallback) */
  .scene.journey[data-height] .journey__stage {
    height: auto;
  }
  .journey__head {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding: var(--stage-pad-y) var(--stage-pad-x) var(--space-5);
  }
  .journey__title {
    max-width: 22ch;
    text-wrap: balance;
  }
  .journey__body {
    display: grid;
    grid-template-columns: 2.75rem 88px minmax(0, 1fr);
    column-gap: var(--space-4);
    padding: 0 var(--stage-pad-x) var(--stage-pad-y);
  }
  .jcount,
  .jcount__mask,
  .jmodels,
  .jframe,
  .jlist,
  .jlist__view,
  .jsteps {
    display: contents;
  }
  .jcount__total,
  .jcaps,
  .jlist__label,
  .jprogress {
    display: none;
  }
  .jnum,
  .jmodel,
  .jstep {
    grid-row: var(--i);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border-soft);
  }
  .jnum {
    grid-column: 1;
    font-size: var(--fs-h4);
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }
  .jmodel {
    grid-column: 2;
    margin: 0;
  }
  .jmodel .picture {
    display: block;
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .jstep {
    grid-column: 3;
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }
  .jstep__index {
    display: none;
  }
  .jstep__title {
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-tight);
  }
  .jstep__caption {
    max-width: 32rem;
    font-size: var(--fs-body-sm);
    color: var(--text-secondary);
  }
  @media (min-width: 640px) {
    .journey__body {
      grid-template-columns: 4rem 160px minmax(0, 1fr);
      column-gap: var(--space-6);
    }
    .jnum {
      font-size: var(--fs-num);
      line-height: 1;
      letter-spacing: -0.04em;
    }
  }

  /* ================================================================ staged (motion): ONE pinned stage */
  @media (prefers-reduced-motion: no-preference) {
    .journey:not(.motion-fallback)[data-height] .journey__stage {
      height: var(--stage-h);
    }
    .journey:not(.motion-fallback) {
      --jpitch: 32px;
      --jm: min(100%, calc(var(--stage-h) - 2 * var(--stage-pad-y) - 150px), 460px);
    }
    .journey:not(.motion-fallback) .journey__track {
      position: absolute;
      inset: 0 0 auto;
    }
    .journey:not(.motion-fallback) .journey__head {
      padding-bottom: 0;
    }
    .journey:not(.motion-fallback) .journey__body {
      position: relative;
      height: var(--stage-h);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-4);
      padding: var(--stage-pad-y) var(--stage-pad-x);
    }
    .journey:not(.motion-fallback) .jnum,
    .journey:not(.motion-fallback) .jmodel,
    .journey:not(.motion-fallback) .jstep {
      padding: 0;
      border: 0;
    }

    /* number: masked vertical roll */
    .journey:not(.motion-fallback) .jcount {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      position: absolute;
      top: var(--stage-pad-y);
      left: var(--stage-pad-x);
      margin: 0;
      font-size: var(--fs-num);
      font-weight: var(--fw-regular);
      line-height: 1;
      letter-spacing: -0.04em;
      font-variant-numeric: tabular-nums;
      color: var(--text-primary);
    }
    .journey:not(.motion-fallback) .jcount__mask {
      display: block;
      position: relative;
      width: 1.24em;
      height: 1em;
      overflow: hidden;
    }
    .journey:not(.motion-fallback) .jnum {
      position: absolute;
      inset: 0 auto auto 0;
      font-size: inherit;
      line-height: 1;
    }
    .journey:not(.motion-fallback) .jnum:not(:first-child) {
      transform: translate3d(0, 100%, 0);
    }
    .journey:not(.motion-fallback) .jcount__total {
      display: inline;
      font-size: var(--fs-label);
      font-weight: var(--fw-medium);
      letter-spacing: var(--ls-label);
      color: var(--text-secondary);
    }

    /* model 1:1 + caption */
    .journey:not(.motion-fallback) .jmodels {
      display: contents;
    }
    .journey:not(.motion-fallback) .jframe {
      display: block;
      order: 1;
      position: relative;
      width: var(--jm);
      aspect-ratio: 1;
      flex: none;
      border-radius: var(--media-radius);
      overflow: hidden;
      background: var(--surface-muted);
      isolation: isolate;
    }
    .journey:not(.motion-fallback) .jmodel {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
    }
    .journey:not(.motion-fallback) .jmodel .picture {
      height: 100%;
      aspect-ratio: auto;
      border-radius: 0;
    }
    .journey:not(.motion-fallback) .jmodel:not(:first-child) {
      opacity: 0;
    }
    .journey:not(.motion-fallback) .jcaps {
      display: grid;
      order: 3;
      width: var(--jm);
    }
    .jcap {
      grid-area: 1 / 1;
      max-width: 34ch;
      font-size: var(--fs-small);
      line-height: 1.45;
      color: var(--text-secondary);
    }
    .journey:not(.motion-fallback) .jcap:not(:first-child) {
      opacity: 0;
    }

    /* step list: one swapping row (tablet / phone) */
    .journey:not(.motion-fallback) .jlist {
      display: block;
      order: 2;
      width: var(--jm);
    }
    .journey:not(.motion-fallback) .jlist__view {
      display: block;
      height: var(--jpitch);
      overflow: hidden;
    }
    .journey:not(.motion-fallback) .jsteps {
      display: block;
    }
    .journey:not(.motion-fallback) .jstep {
      display: block;
      height: var(--jpitch);
    }
    .journey:not(.motion-fallback) .jstep__row {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      height: 100%;
    }
    .journey:not(.motion-fallback) .jstep:not(:first-child) .jstep__row {
      opacity: 0.2; /* = --text-faint */
    }
    .journey:not(.motion-fallback) .jstep__index {
      display: block;
      font-size: var(--fs-label);
      font-weight: var(--fw-medium);
      letter-spacing: var(--ls-label);
      font-variant-numeric: tabular-nums;
    }
    .journey:not(.motion-fallback) .jstep__title {
      white-space: nowrap;
    }
    /* captions live in .jcaps visually; the list keeps them for screen readers */
    .journey:not(.motion-fallback) .jstep__caption {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* tablet: a little more air, bigger single row */
  @media (min-width: 640px) and (prefers-reduced-motion: no-preference) {
    .journey:not(.motion-fallback) {
      --jpitch: 40px;
    }
    .journey:not(.motion-fallback) .journey__body {
      gap: var(--space-5);
    }
  }

  /* desktop: number | model | list | progress */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .journey:not(.motion-fallback) {
      --jpitch: 72px;
      --jm: min(100%, calc(var(--stage-h) - 2 * var(--stage-pad-y) - 64px));
    }
    .journey:not(.motion-fallback) .journey__title {
      max-width: none;
    }
    .journey:not(.motion-fallback) .journey__body {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      align-items: start;
      align-content: center;
    }
    .journey:not(.motion-fallback) .jcount {
      position: static;
      grid-column: 1 / 3;
      grid-row: 1;
      align-self: center;
      margin-bottom: 3.5rem; /* optical: centre on the model, not model + caption */
    }
    .journey:not(.motion-fallback) .jmodels {
      display: grid;
      gap: var(--space-4);
      grid-column: 3 / 8;
      grid-row: 1;
      width: var(--jm);
    }
    .journey:not(.motion-fallback) .jframe,
    .journey:not(.motion-fallback) .jcaps {
      width: 100%;
    }
    .journey:not(.motion-fallback) .jlist {
      grid-column: 9 / 13;
      grid-row: 1;
      width: auto;
    }
    .journey:not(.motion-fallback) .jlist__label {
      display: block;
      padding-bottom: var(--space-4);
    }
    .journey:not(.motion-fallback) .jlist__view {
      height: calc(var(--jpitch) * 5);
      border-top: 1px solid var(--border-soft);
    }
    .journey:not(.motion-fallback) .jstep {
      border-bottom: 1px solid var(--border-soft);
    }
    .journey:not(.motion-fallback) .jstep__row {
      gap: var(--space-5);
    }
    .journey:not(.motion-fallback) .jstep__index {
      width: 1.75rem;
    }
    /* thin progress line at the stage's right edge */
    .journey:not(.motion-fallback) .jprogress {
      display: block;
      position: absolute;
      right: 24px;
      top: 50%;
      width: 1px;
      height: 96px;
      margin-top: -48px;
      background: var(--border-soft);
    }
    .jprogress span {
      position: absolute;
      inset: 0;
      background: var(--text-primary);
      transform: scaleY(0);
      transform-origin: 50% 0;
    }
  }
</style>
