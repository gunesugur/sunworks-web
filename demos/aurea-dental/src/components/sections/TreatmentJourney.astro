---
import { site } from '../../content/site';
import SceneFrame from '../scene/SceneFrame.astro';
import Img from '../ui/Img.astro';
const data=site.journey;
---
<SceneFrame name="journey" section="journey" id="journey" labelledby="journey-title" class="journey" stageClass="journey__stage">
 <header class="journey__head"><p class="label">Your treatment, explained</p><h2 id="journey-title" class="t-h2">{data.titleLines.join(' ')}</h2></header>
 <ol class="journey__stories" data-journey-stories>{data.steps.map(s=><li class="journey__story" data-journey-story><div class="journey__model"><Img image={s.image} alt={s.imageAlt} widths={[480,768,1080]} sizes="(min-width:1024px) 45vw, 240px" /></div><div class="journey__detail"><p class="journey__number">{s.index}<span> / 05</span></p><h3>{s.title}</h3><p>{s.caption}</p></div></li>)}</ol>
 <nav class="journey__nav" aria-label="Treatment steps" data-journey-nav>{data.steps.map((s,i)=><button type="button" data-journey-step={i} aria-current={i===0?'step':undefined}><span>{s.index}</span>{s.title}</button>)}</nav>
 <div class="journey__progress" aria-hidden="true"><span data-journey-progress></span></div>
</SceneFrame>
<style is:global>
 .scene.journey .journey__stage { height:auto; background:var(--surface-muted); padding:var(--stage-pad-y) var(--stage-pad-x); }
 .journey__head { display:grid; gap:20px; margin-bottom:40px; }
 .journey__head h2 { max-width:24ch; }
 .journey__stories { display:grid; gap:32px; }
 .journey__story { display:grid; grid-template-columns: minmax(80px,.45fr) 1fr; gap:24px; align-items:center; border-top:1px solid var(--border-soft); padding-top:24px; }
 .journey__model .picture,.journey__model .img { width:100%; height:100%; object-fit:contain; }
 .journey__model { mix-blend-mode:multiply; }
 .journey__detail { display:grid; gap:16px; }
 .journey__number { font-size:24px; font-variant-numeric:tabular-nums; }
 .journey__number span { font-size:14px; color:var(--text-secondary); }
 .journey__detail h3 { font:500 24px/1.15 var(--font-sans); }
 .journey__detail > p:last-child { font-size:17px; color:var(--text-secondary); max-width:32ch; }
 .journey__nav,.journey__progress { display:none; }
 @media(min-width:1024px) and (prefers-reduced-motion:no-preference) {
  html.motion-enabled .scene.journey { height:320svh; min-height:0; padding:0; display:block; }
  html.motion-enabled .scene.journey > .scene__pin { position:sticky; top:0; height:100svh; display:block; }
  html.motion-enabled .scene.journey .journey__stage { height:100svh; width:100%; border-radius:0; padding:0; }
  html.motion-enabled .journey__head { position:absolute; top:120px; left:clamp(48px,8vw,140px); right:clamp(48px,8vw,140px); margin:0; }
  html.motion-enabled .journey__head h2 { font-size:clamp(36px,3.5vw,56px); }
  html.motion-enabled .journey__stories { position:absolute; top:260px; bottom:160px; left:clamp(48px,8vw,140px); right:clamp(48px,8vw,140px); display:block; }
  html.motion-enabled .journey__story { position:absolute; inset:0; border:0; padding:0; grid-template-columns:1.1fr .9fr; gap:8vw; }
  html.motion-enabled .journey__story:not(:first-child) { opacity:0; visibility:hidden; }
  html.motion-enabled .journey__model { height:100%; min-height:0; max-height:500px; }
  html.motion-enabled .journey__number { font-size:clamp(48px,5vw,72px); letter-spacing:-.04em; }
  html.motion-enabled .journey__number span { font-size:18px; margin-left:12px; }
  html.motion-enabled .journey__detail h3 { font-size:clamp(28px,3vw,42px); }
  html.motion-enabled .journey__detail > p:last-child { font-size:18px; }
  html.motion-enabled .journey__nav { position:absolute; left:clamp(48px,8vw,140px); right:clamp(48px,8vw,140px); bottom:48px; display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:24px; }
  .journey__nav button { border-top:1px solid var(--border-soft); padding-top:18px; display:grid; gap:8px; text-align:left; font-size:16px; color:var(--text-secondary); }
  .journey__nav button > span { font-size:13px; }
  .journey__nav button[aria-current='step'] { color:var(--text-primary); border-color:var(--text-primary); }
  html.motion-enabled .journey__progress { display:block; position:absolute; bottom:0; left:0; right:0; height:3px; background:var(--border-soft); }
  .journey__progress span { display:block; height:100%; background:var(--text-primary); transform:scaleX(0); transform-origin:left; }
 }
 @media(min-width:1024px) and (max-height:800px) and (prefers-reduced-motion:no-preference) { html.motion-enabled .journey__head { top:100px; } html.motion-enabled .journey__stories { top:210px; bottom:138px; } html.motion-enabled .journey__nav { bottom:32px; } }
</style>
