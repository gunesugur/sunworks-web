---
/**
 * Scene 2 — Intro / clinic statement (LOW–MED, "quiet"). RisingPanel with the short overlap: it rises over the
 * pinned hero (hand-off 1), then recedes (exit="recede" on [data-recede] = the statement column) while the
 * Benefits photo grows into its stage (hand-off 2). Interior (statement.ts): scroll-driven phrase inking via
 * inkPhrases(); thumbnail clip reveal + metrics stagger via data-reveal.
 * Asymmetric: small 1:1 clinic detail top-left, metrics lower-left, large statement right from 50 %.
 * Metrics are placeholders (verified: false in site.ts) — rendered with data-verified="false".
 */
import { site } from '../../content/site';
import RisingPanel from '../scene/RisingPanel.astro';
import MaskedMedia from '../scene/MaskedMedia.astro';

const { statement } = site;
---
<RisingPanel name="intro" section="statement" id="about" labelledby="statement-title" overlap="short" exit="recede" class="intro">
  <div class="intro__grid">
    <div class="intro__aside">
      <div class="intro__thumb" data-reveal="clip" data-reveal-from="left">
        <MaskedMedia image={statement.image} alt={statement.imageAlt} sizes="(min-width: 1024px) 184px, 160px" widths={[240, 480]} ratio="1 / 1" position="50% 50%" />
      </div>
      <dl class="intro__stats" data-reveal="stagger" data-reveal-start="top 92%">
        {
          statement.stats.map((stat) => (
            <div class="intro__stat" data-verified={String(stat.verified)}>
              <dt class="intro__stat-label">{stat.label}</dt>
              <dd class="intro__stat-value">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="intro__main" data-recede>
      <p class="label label--dark intro__label"><span class="intro__dot" aria-hidden="true"></span>{statement.label}</p>
      <h2 id="statement-title" class="intro__statement" data-ink-root>
        {statement.phrases.map((phrase, i) => <span data-ink>{phrase}{i < statement.phrases.length - 1 ? ' ' : ''}</span>)}
      </h2>
    </div>
  </div>
</RisingPanel>

<style>
  .intro__grid {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-7) var(--stage-pad-x) var(--space-8);
  }
  .intro__aside {
    display: grid;
    gap: var(--space-6);
    order: 2;
  }
  .intro__thumb {
    width: 128px;
  }
  .intro__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .intro__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
  }
  .intro__stat-value {
    font-size: var(--fs-stat);
    font-weight: var(--fw-book);
    letter-spacing: var(--ls-heading);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }
  .intro__stat-label {
    font-size: var(--fs-small);
    line-height: 1.3;
    color: var(--text-secondary);
  }
  .intro__main {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .intro__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--text-primary);
  }
  .intro__statement {
    font-size: var(--fs-statement);
    font-weight: var(--fw-book);
    line-height: 1.22;
    letter-spacing: -0.02em;
    max-width: 22ch;
    text-wrap: pretty;
  }
  .intro__statement [data-ink] {
    transition: none;
  }

  /* hand-off 2: the panel's lower edge meets the Benefits stage's upper edge (no ambient gap between the two
     scenes) — the photo then grows inside a surface that reads as the continuation of this one */
  @media (min-width: 640px) and (prefers-reduced-motion: no-preference) {
    :global(.scene.intro) {
      margin-bottom: calc(-1 * var(--stage-top));
    }
  }

  @media (min-width: 640px) {
    .intro__grid {
      grid-template-columns: 160px minmax(0, 1fr);
      column-gap: var(--space-7);
      padding-block: clamp(56px, 9svh, 96px) clamp(72px, 12svh, 128px);
    }
    .intro__aside {
      order: 0;
      align-content: space-between;
    }
    .intro__thumb {
      width: 160px;
    }
    .intro__stats {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  @media (min-width: 1024px) {
    .intro__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      min-height: min(var(--stage-h), 100svh);
      padding-block: clamp(64px, 10svh, 120px) clamp(72px, 12svh, 140px);
    }
    .intro__aside {
      grid-column: 1 / 6;
      grid-row: 1;
      align-content: space-between;
      gap: var(--space-8);
    }
    .intro__thumb {
      width: 184px;
    }
    .intro__stats {
      grid-template-columns: repeat(3, 142px);
      gap: 0;
    }
    .intro__main {
      grid-column: 7 / -1;
      grid-row: 1;
      gap: var(--space-6);
    }
    .intro__statement {
      max-width: 21ch;
    }
  }
</style>
