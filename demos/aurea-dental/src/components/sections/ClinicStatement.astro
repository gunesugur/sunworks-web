---
import { site } from '../../content/site';
import SceneFrame from '../scene/SceneFrame.astro';
import Img from '../ui/Img.astro';
const { statement } = site;
---
<SceneFrame name="intro" id="about" labelledby="statement-title" frame="panel" class="intro">
  <div class="clinic__photo" data-reveal="clip" data-reveal-from="left"><Img image={statement.image} alt={statement.imageAlt} sizes="(min-width:1024px) 40vw, 100vw" widths={[480,960,1440]} cover /></div>
  <div class="clinic__text" data-reveal="fade"><p class="label">The clinic</p><h2 id="statement-title">A little more time.<br />A clearer understanding.</h2><p>We start by listening. Then we explain what we see, discuss the alternatives and build a plan with you.</p><ol>{statement.stats.map(s=><li><span>{s.value}</span>{s.label}</li>)}</ol></div>
</SceneFrame>
<style is:global>
  .scene.intro .panel { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; padding: var(--stage-pad-y) var(--stage-pad-x); background: var(--surface); }
  .clinic__photo { min-height: 420px; }
  .clinic__photo .picture, .clinic__photo .img { width: 100%; height: 100%; }
  .clinic__text { align-self: center; display: grid; gap: 28px; }
  .clinic__text h2 { font-size: var(--fs-h2); }
  .clinic__text > p:not(.label) { color: var(--text-secondary); font-size: var(--fs-body-lg); }
  .clinic__text ol { border-top: 1px solid var(--border-soft); }
  .clinic__text li { padding: 16px 0; border-bottom: 1px solid var(--border-soft); display: flex; gap: 24px; font-size: 17px; }
  .clinic__text li span { color: var(--text-secondary); }
  @media(max-width:1023.98px) { .scene.intro .panel { grid-template-columns: 1fr; gap: 32px; } .clinic__photo { min-height: 0; aspect-ratio: 4 / 3; } }
</style>
