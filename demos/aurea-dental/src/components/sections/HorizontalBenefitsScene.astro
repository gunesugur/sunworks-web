---
import { site } from '../../content/site';
import SceneFrame from '../scene/SceneFrame.astro';
import MaskedMedia from '../scene/MaskedMedia.astro';
const { benefits } = site;
---
<SceneFrame name="benefits" id="technology" labelledby="benefits-title" class="benefits" stageClass="benefits__stage">
  <header class="benefits__head">
    <p class="label">Our approach</p>
    <h2 id="benefits-title" class="t-h2">{benefits.titleLines.join(' ')}</h2>
    <p>{benefits.intro}</p>
  </header>
  <MaskedMedia image={benefits.image} alt="Daylit dental treatment room with digital equipment" sizes="(min-width:1024px) 40vw, 100vw" widths={[768,1080,1440]} ratio="4 / 5" class="benefits__media" />
  <ol class="benefits__list">
    {benefits.items.map(item => <li><span class="benefit__number">{item.index}</span><div><h3>{item.title}</h3><p>{item.copy}</p></div></li>)}
  </ol>
</SceneFrame>
<style is:global>
  .scene.benefits .benefits__stage { height: auto; background: var(--bg-soft); padding: var(--stage-pad-y) var(--stage-pad-x); display: grid; grid-template-columns: .85fr 1.15fr; gap: 48px 64px; }
  .benefits__head { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1.6fr; gap: 20px 64px; align-items: start; }
  .benefits__head h2 { max-width: 20ch; }
  .benefits__head > p:last-child { grid-column: 2; color: var(--text-secondary); }
  .benefits__media { align-self: stretch; }
  .benefits__list { display: grid; align-content: start; }
  .benefits__list li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; padding: 22px 0; border-top: 1px solid var(--border-soft); }
  .benefit__number { color: var(--text-secondary); font-size: 13px; padding-top: 5px; }
  .benefits__list h3 { font: 500 21px/1.3 var(--font-sans); }
  .benefits__list p { font-size: 16px; color: var(--text-secondary); margin-top: 8px; }
  @media(max-width:1023.98px) { .scene.benefits .benefits__stage { grid-template-columns: 1fr; gap: 32px; } .benefits__media { aspect-ratio: 16 / 9 !important; } .benefits__head { grid-template-columns: 1fr; gap: 18px; } .benefits__head > p:last-child { grid-column: 1; } }
</style>
