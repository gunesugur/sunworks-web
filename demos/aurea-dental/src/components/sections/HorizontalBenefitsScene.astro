---
/**
 * §6 Signature scene. Desktop (≥1024, motion): section = 100svh stage + 150vh scrub + overlap;
 * the stage is CSS-sticky, the track is scrubbed right → left, and the following `.panel-rise`
 * (Services) rises over the still-sticky stage. Mobile / reduced motion: native scroll-snap row.
 */
import { site } from '../../content/site';
import Img from '../ui/Img.astro';
import RevealText from '../ui/RevealText.astro';

const { benefits } = site;
const total = String(benefits.items.length).padStart(2, '0');
---
<section class="benefits" id="technology" data-section="benefits" aria-labelledby="benefits-title">
  <div class="benefits__stage" data-benefits-stage>
    <div class="benefits__bg" data-benefits-bg aria-hidden="true">
      <Img image={benefits.image} alt="" sizes="100vw" cover position="50% 60%" />
    </div>
    <div class="benefits__depth" data-benefits-depth aria-hidden="true">
      <Img image={benefits.image} alt="" sizes="50vw" widths={[480, 768]} cover quality={50} />
    </div>
    <div class="benefits__scrim" aria-hidden="true"></div>

    <div class="benefits__content" data-benefits-content>
      <div class="benefits__head container">
        <div class="benefits__heading">
          <p class="label label--dark" data-reveal="fade">{benefits.label}</p>
          <RevealText as="h2" id="benefits-title" class="benefits__title t-h2" lines={benefits.titleLines} />
        </div>
        <div class="benefits__meta" data-reveal="fade" data-reveal-delay="0.2">
          <p class="benefits__intro">{benefits.intro}</p>
          <div class="benefits__counter" aria-hidden="true">
            <span class="benefits__count"><span data-benefits-current>01</span> / {total}</span>
            <span class="benefits__progress"><span data-benefits-progress></span></span>
          </div>
        </div>
      </div>

      <div class="benefits__viewport" data-benefits-viewport data-region-label={benefits.titleLines.join(" ")}>
        <ol class="benefits__track" data-benefits-track>
          {
            benefits.items.map((item) => (
              <li class="benefit-card" data-benefit-card>
                <span class="benefit-card__index label">{item.index}</span>
                <div class="benefit-card__body">
                  <h3 class="benefit-card__title">{item.title}</h3>
                  <p class="benefit-card__copy">{item.copy}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
    <div class="benefits__shade" data-benefits-shade aria-hidden="true"></div>
  </div>
</section>

<style>
  .benefits {
    --benefits-scroll: 150vh;
    --card-w: min(78vw, 300px);
    --card-h: 230px;
    position: relative;
    background: var(--color-surface);
  }
  .benefits__stage {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-pad-sm);
    isolation: isolate;
  }
  .benefits__bg,
  .benefits__depth,
  .benefits__scrim,
  .benefits__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .benefits__bg {
    z-index: -3;
  }
  .benefits__bg :global(.picture),
  .benefits__depth :global(.picture) {
    height: 100%;
  }
  /* blurred, enlarged depth layer — diffuses the band the cards sit on */
  .benefits__depth {
    z-index: -2;
    opacity: 0.16;
    transform: scale(1.3);
    filter: blur(56px);
    -webkit-mask-image: linear-gradient(to top, #000 0%, #000 35%, transparent 70%);
    mask-image: linear-gradient(to top, #000 0%, #000 35%, transparent 70%);
  }
  .benefits__scrim {
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(244, 244, 241, 0.82) 0%, rgba(244, 244, 241, 0.35) 38%, rgba(244, 244, 241, 0) 60%),
      linear-gradient(0deg, rgba(244, 244, 241, 0.5) 0%, rgba(244, 244, 241, 0) 40%);
  }
  .benefits__shade {
    z-index: 2;
    background: var(--color-text);
    opacity: 0;
  }

  .benefits__head {
    display: grid;
    gap: var(--space-6);
  }
  .benefits__heading {
    display: grid;
    gap: var(--space-5);
  }
  .benefits__meta {
    display: grid;
    gap: var(--space-4);
    max-width: 22rem;
  }
  .benefits__intro {
    color: var(--color-text-2);
  }
  .benefits__counter {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }
  .benefits__progress {
    position: relative;
    flex: 1;
    max-width: 140px;
    height: 1px;
    background: var(--color-border-strong);
    overflow: hidden;
  }
  .benefits__progress span {
    position: absolute;
    inset: 0;
    background: var(--color-text);
    transform: scaleX(0.1667);
    transform-origin: left center;
  }

  /* ---- native row (mobile, tablet, reduced motion) ---- */
  .benefits__viewport {
    margin-top: var(--space-7);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .benefits__viewport::-webkit-scrollbar {
    display: none;
  }
  .benefits__track {
    display: flex;
    gap: 12px;
    width: max-content;
    padding-inline: var(--gutter);
  }
  .benefit-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    width: var(--card-w);
    min-height: var(--card-h);
    padding: 22px 22px 24px;
    border-radius: 20px;
    background: var(--color-card);
    border: 1px solid var(--color-border-soft);
    scroll-snap-align: start;
    opacity: 0.8;
    transition: opacity var(--duration-medium) var(--ease-primary);
  }
  .benefit-card.is-active {
    opacity: 1;
  }
  .benefit-card__index {
    color: var(--color-text);
  }
  .benefit-card__title {
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-tight);
    line-height: var(--lh-snug);
  }
  .benefit-card__copy {
    margin-top: var(--space-3);
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-text-2);
  }
  .benefits__viewport:focus-visible {
    outline-offset: -4px;
  }

  @media (min-width: 1024px) {
    .benefits {
      --card-w: clamp(260px, 21vw, 320px);
      --card-h: clamp(210px, 17vw, 260px);
    }
    .benefits__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      align-items: end;
    }
    .benefits__heading {
      grid-column: 1 / 8;
    }
    .benefits__meta {
      grid-column: 9 / -1;
      justify-self: end;
      width: 100%;
    }
    .benefit-card {
      height: var(--card-h);
      padding: 24px 26px 26px;
      border-radius: 22px;
    }
  }

  /* ---- pinned, scrubbed scene ---- */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .benefits {
      height: calc(100svh + var(--benefits-scroll) + var(--panel-rise-overlap));
    }
    .benefits__stage {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 640px;
      padding: 0;
    }
    .benefits__content {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      padding-top: calc(var(--header-h) + clamp(24px, 6vh, 72px));
      padding-bottom: clamp(40px, 9vh, 96px);
    }
    .benefits__viewport {
      position: relative;
      align-self: end;
      margin: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
    .benefits__track {
      padding: 0;
      will-change: transform;
    }
    /* --focus (0…1) is written by benefits.ts: active card scale 1.035 + full opacity */
    .benefit-card {
      --focus: 0;
      opacity: calc(0.72 + 0.28 * var(--focus));
      transform: scale(calc(1 + 0.035 * var(--focus)));
      background: color-mix(in srgb, var(--color-white) calc(var(--focus) * 60%), var(--color-card));
      transition: none;
      transform-origin: 50% 100%;
      will-change: transform, opacity;
    }
    .benefits__bg,
    .benefits__depth {
      will-change: transform;
    }
  }
</style>
