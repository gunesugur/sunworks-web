---
/**
 * §9 FAQSection — QUIET (motion kit §4 #7–8, §5 FAQ). <SceneFrame frame="column" exit="recede">: no surface, no
 * scroll choreography; the column recedes (y −8 vh, opacity .4) while the Booking image grows in beneath it.
 * Left 4/12: label, heading, short copy, quiet text link. Right 7/12: accordion — 1 px rules, 76 px rows, 16 px
 * questions, 22 px circle +/–, one open at a time (faq.ts: height + opacity + y 6 → 0, 380 ms).
 * No-JS: every answer is rendered open (aria-expanded="true").
 */
import { site } from '../../content/site';
import SceneFrame from '../scene/SceneFrame.astro';
import Button from '../ui/Button.astro';

const data = site.faq;
---
<SceneFrame name="faq" section="faq" id="faq" labelledby="faq-title" frame="column" exit="recede" class="faq" stageClass="faq__column">
  <div class="faq__intro">
    <p class="label label--dark">{data.label}</p>
    <h2 id="faq-title" class="t-h2 faq__title">
      {data.titleLines.map((line, i) => <span class="faq__title-line">{line}{i < data.titleLines.length - 1 ? ' ' : ''}</span>)}
    </h2>
    <p class="faq__text">{data.intro}</p>
    <Button href={data.cta.href} variant="link">{data.cta.label}</Button>
  </div>

  <div class="faq__list" data-faq-list>
    {
      data.items.map((item) => (
        <div class="faq-item" data-faq-item>
          <h3 class="faq-item__heading">
            <button
              type="button"
              class="faq-item__trigger"
              id={`faq-q-${item.id}`}
              aria-expanded="true"
              aria-controls={`faq-a-${item.id}`}
              data-faq-trigger
            >
              <span class="faq-item__q">{item.question}</span>
              <span class="faq-item__icon" aria-hidden="true" />
            </button>
          </h3>
          <div class="faq-item__panel" id={`faq-a-${item.id}`} role="region" aria-labelledby={`faq-q-${item.id}`} data-faq-panel>
            <div class="faq-item__body" data-faq-body>
              <p>{item.answer}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</SceneFrame>

<style is:global>
  .faq .faq__column {
    display: grid;
    gap: var(--space-7);
    padding: var(--section-pad-sm) var(--stage-pad-x);
  }
  .faq__intro {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-4);
  }
  .faq__title-line {
    display: block;
  }
  .faq__text {
    max-width: 30ch;
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .faq__list {
    border-bottom: 1px solid var(--border-soft);
  }
  .faq-item {
    border-top: 1px solid var(--border-soft);
  }
  .faq-item__heading {
    font: inherit;
    letter-spacing: normal;
  }
  .faq-item__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    width: 100%;
    min-height: 64px;
    padding: 18px 0;
    text-align: left;
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    letter-spacing: -0.005em;
    line-height: 1.35;
    color: var(--text-primary);
  }
  .faq-item__trigger:focus-visible {
    outline-offset: -2px;
  }
  /* 22 px circle with a thin + / – */
  .faq-item__icon {
    position: relative;
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--border-soft);
    color: var(--text-secondary);
    transition:
      color var(--duration-ui) var(--ease-soft),
      box-shadow var(--duration-ui) var(--ease-soft);
  }
  .faq-item__icon::before,
  .faq-item__icon::after {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
    top: 10.5px;
    height: 1px;
    background: currentColor;
    transition: transform var(--duration-ui) var(--ease-primary);
  }
  .faq-item__icon::after {
    transform: rotate(90deg);
  }
  .faq-item__trigger[aria-expanded='true'] .faq-item__icon::after {
    transform: rotate(0deg);
  }
  .faq-item__trigger[aria-expanded='true'] .faq-item__icon,
  .faq-item__trigger:hover .faq-item__icon {
    color: var(--text-primary);
    box-shadow: inset 0 0 0 1px rgba(20, 20, 20, 0.28);
  }
  .faq-item__panel {
    overflow: hidden;
  }
  .faq-item__body {
    padding: 0 var(--space-7) var(--space-5) 0;
  }
  .faq-item__body p {
    max-width: 56ch;
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    color: var(--text-secondary);
  }

  @media (min-width: 640px) {
    .faq .faq__column {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }
    .faq__intro {
      grid-column: 1 / 6;
    }
    .faq__list {
      grid-column: 6 / -1;
    }
  }
  @media (min-width: 1024px) {
    .faq .faq__column {
      padding-block: var(--section-pad) var(--section-pad-sm);
    }
    .faq__intro {
      grid-column: 1 / 5;
    }
    .faq__list {
      grid-column: 6 / -1;
    }
    .faq-item__trigger {
      min-height: 76px;
      padding: 22px 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item__icon,
    .faq-item__icon::before,
    .faq-item__icon::after {
      transition: none;
    }
  }
</style>
