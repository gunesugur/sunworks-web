import { site } from '../../content/site';
import RevealText from '../ui/RevealText.astro';

const data = site.faq;
---
<section class="faq" id="faq" data-section="faq" aria-labelledby="faq-title">
  <div class="container stub">
    <p class="label">{data.label}</p>
    <RevealText as="h2" id="faq-title" class="t-h2" lines={data.titleLines} />
  </div>
</section>

<style>
  .stub {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--section-pad);
  }
</style>
