---
import type { Service } from '@/content/schema';
import ArrowButton from './ArrowButton.astro';
import Img from './Img.astro';
import Notched from './Notched.astro';

interface Props {
  service: Service;
  href: string;
  ratio?: string;
  label: string;
  headingLevel?: 'h2' | 'h3';
}
const { service, href, ratio = '1 / 1', label, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="card card-link">
  <Notched corner="tr" ratio={ratio}>
    <Img image={service.image} widths={[400, 640, 900]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 410px" />
    <ArrowButton slot="corner" />
  </Notched>
  <div class="card__body">
    <Heading class="card__title">
      <a href={href} class="card__link">
        {service.title}<span class="sr-only">, {label}</span>
      </a>
    </Heading>
    <p class="card__text">{service.excerpt}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }

  .card__title {
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: var(--lh-head);
  }

  .card__link {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size var(--dur) var(--ease-out);
  }

  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--r-card);
  }

  .card:hover .card__link,
  .card__link:focus-visible {
    background-size: 100% 2px;
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card__link:focus-visible::after {
    outline: var(--focus);
    outline-offset: 6px;
  }

  .card__text {
    margin-top: 1rem;
    color: var(--c-muted);
    font-size: var(--fs-small);
  }

  .card:hover :global(.notched__media img) {
    transform: scale(1.045);
  }
</style>
