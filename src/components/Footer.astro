---
import type { Locale, Navigation, SiteSettings } from '@/content/schema';
import { otherLocale, routes } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { siGithub, siInstagram, siX } from 'simple-icons';
import Asterisk from './Asterisk.astro';
import Logo from './Logo.astro';
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  lang: Locale;
  nav: Navigation;
  settings: SiteSettings;
  altHref: string;
}
const { lang, nav, settings, altHref } = Astro.props;
const s = t(lang);
const year = new Date().getUTCFullYear();
const altLang = otherLocale(lang);
const word = 'SUN | WORKS'.split('');
// Brand glyphs (simple-icons, rendered at build time). LinkedIn is not in simple-icons, so its mark is drawn here.
const LINKEDIN =
  'M4.5 2h15A2.5 2.5 0 0 1 22 4.5v15a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 19.5v-15A2.5 2.5 0 0 1 4.5 2Zm2.2 7.3V18h2.8V9.3H6.7Zm1.4-4.4a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2Zm4.3 4.4V18h2.8v-4.5c0-1.3.6-2.1 1.7-2.1s1.5.8 1.5 2.1V18h2.8v-5.2c0-2.5-1.3-3.7-3.2-3.7-1.3 0-2.2.6-2.8 1.4V9.3h-2.8Z';
const GLYPH: Record<string, string> = { instagram: siInstagram.path, github: siGithub.path, x: siX.path, linkedin: LINKEDIN };
---

<footer class="site-footer" transition:name="site-footer">
  <div class="container">
    <div class="footer on-dark scheme-fixed" data-footer>
      <span class="footer__glow" aria-hidden="true" data-glow></span>
      <div class="footer__top">
        <nav class="footer__cols" aria-label={s.footerNav}>
          {
            nav.footerColumns.map((col) => (
              <div class="footer__col">
                <h2 class="footer__title">{col.title}</h2>
                <ul>
                  {col.links.map((l) => (
                    <li>
                      <a href={l.href}>{l.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>

        <div class="footer__news">
          <h2 class="footer__nl-title">
            {settings.newsletter.title}
            <Asterisk class="footer__star" size="0.9em" />
          </h2>
          <p class="footer__nl-text">{settings.newsletter.text}</p>
          <NewsletterForm lang={lang} email={settings.email} />
        </div>
      </div>

      <ul class="footer__social">
        {
          settings.socials.map((so) => {
            const pending = so.url === '#';
            return (
              <li>
                {pending ? (
                  <span class="social social--pending" title={s.socialPending}>
                    <svg class="social__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={GLYPH[so.platform]} /></svg>
                    {s.social[so.platform]} <span class="sr-only">{s.socialPending}</span>
                  </span>
                ) : (
                  <a class="social" href={so.url} rel="me noopener noreferrer">
                    <svg class="social__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={GLYPH[so.platform]} /></svg>
                    {s.social[so.platform]}
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>

      <div class="footer__word" aria-hidden="true" data-word>
        {word.map((ch, i) => <span style={`--i:${i}`}>{ch === ' ' ? ' ' : ch}</span>)}
      </div>

      <div class="footer__bottom">
        <p>© {year} <strong>{settings.siteName}</strong></p>
        <ul class="footer__legal">
          {
            nav.legalLinks.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
          <li><button type="button" class="footer__consent" data-consent-open>{s.cookieSettings}</button></li>
          <li><a href={altHref} hreflang={altLang} lang={altLang}>{s.langSwitch}</a></li>
        </ul>
      </div>
      <div class="footer__brand"><Logo href={routes.home[lang]} label={settings.siteName} tone="light" /></div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-bottom: var(--gutter);
  }

  .footer {
    position: relative;
    display: grid;
    gap: 2rem;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 8vw, 6.625rem) 2rem;
    border-radius: var(--r-footer);
    background: var(--c-dark);
    color: var(--c-light);
    overflow: hidden;
    isolation: isolate;
  }

  :global(html[data-theme='dark']) .footer {
    background: color-mix(in srgb, var(--paper) 5%, var(--ink));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--paper) 10%, transparent);
  }

  .footer__glow {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: 520px;
    height: 520px;
    margin: -260px 0 0 -260px;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--c-accent) 16%, transparent), transparent);
    opacity: 0;
    transform: translate3d(var(--gx, 50%), var(--gy, 50%), 0);
    transition: opacity var(--dur-slow) ease;
    pointer-events: none;
  }

  .footer:hover .footer__glow {
    opacity: 1;
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr minmax(0, 23rem);
    gap: clamp(2.5rem, 8vw, 8rem);
    align-items: start;
  }

  .footer__cols {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem clamp(2rem, 4vw, 3.4rem);
  }

  .footer__col ul,
  .footer__social,
  .footer__legal {
    padding: 0;
    list-style: none;
  }

  .footer__title {
    margin-bottom: 1.5rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .footer__col li + li {
    margin-top: 0.9rem;
  }

  .footer a {
    color: var(--c-light);
    font-size: var(--fs-small);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size var(--dur) var(--ease-out);
  }

  .footer a:hover {
    background-size: 100% 1px;
  }

  .footer__nl-title {
    display: flex;
    align-items: flex-end;
    gap: 0.9rem;
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.3rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .footer__nl-title :global(.footer__star) {
    color: var(--c-accent);
    margin-bottom: 0.35em;
    animation: spin 14s linear infinite;
  }

  .footer__nl-text {
    margin: 0.9rem 0 2rem;
    color: var(--c-light);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .social {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.35rem 1rem;
    border: 1px solid color-mix(in srgb, var(--c-light) 35%, transparent);
    border-radius: var(--r-pill);
    font-size: var(--fs-xs);
  }

  .footer .social {
    gap: 0.55rem;
    background: none;
    transition:
      border-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .social__icon {
    width: 1.05rem;
    height: 1.05rem;
    fill: currentColor;
    transition:
      fill var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .social:hover {
    border-color: var(--c-accent);
  }

  .social:hover .social__icon {
    fill: var(--c-accent);
    transform: rotate(-8deg) scale(1.1);
  }

  .social--pending {
    color: var(--c-muted-on-dark);
  }

  .footer__word {
    display: flex;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--c-light) 18%, transparent);
    font-size: clamp(2.4rem, 9.6vw, 10rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.03em;
    user-select: none;
    overflow: hidden;
  }

  /* Each letter fades from light into the footer, like the logo's sun sinking below the horizon.
     In the dark theme the letters take the accent instead. Gradient per letter: background-clip
     on the parent breaks once the letters are transformed. */
  .footer__word span {
    --word-top: color-mix(in srgb, var(--c-light) 78%, transparent);
    display: inline-block;
    background: linear-gradient(180deg, var(--word-top) 12%, color-mix(in srgb, var(--c-light) 6%, transparent) 92%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: transform 1.1s var(--ease-out);
    transition-delay: calc(var(--i) * 45ms);
  }

  :global(.js) .footer__word:not(.is-in) span {
    transform: translate3d(0, 105%, 0);
  }

  :global(html[data-theme='dark']) .footer__word span {
    --word-top: color-mix(in srgb, var(--c-accent) 85%, transparent);
  }

  .footer__word span:hover {
    transform: translate3d(0, -8%, 0);
    transition-delay: 0ms;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    font-size: var(--fs-xs);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }

  .footer__legal a {
    font-size: var(--fs-xs);
  }

  .footer__consent {
    padding: 0;
    border: 0;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    color: var(--c-light);
    font-size: var(--fs-xs);
    cursor: pointer;
    transition: background-size var(--dur) var(--ease-out);
  }

  .footer__consent:hover {
    background-size: 100% 1px;
  }

  .footer__brand {
    display: none;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 900px) {
    .footer__top {
      grid-template-columns: 1fr;
    }

    .footer__news {
      order: -1;
    }
  }
</style>
