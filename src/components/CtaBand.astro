---
import type { Locale } from '@/content/schema';
import { getHome } from '@/lib/cms';
import ArrowButton from './ArrowButton.astro';
import Asterisk from './Asterisk.astro';

interface Props {
  lang: Locale;
}
const home = await getHome(Astro.props.lang);
---

<section class="container cta" aria-labelledby="cta-title">
  <div class="cta__box" data-reveal>
    <span class="cta__mark" aria-hidden="true"><Asterisk size="100%" /></span>
    <h2 id="cta-title" class="h2 cta__title">
      {home.closing.title}
      <Asterisk class="cta__star" size="0.6em" />
    </h2>
    <ArrowButton href={home.closing.cta.href} label={home.closing.cta.label} />
  </div>
</section>

<style>
  .cta {
    padding-bottom: var(--section);
  }

  .cta__box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--r-footer);
    background: var(--c-band);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  /* Watermark: the brand asterisk, large and faint, turning slowly in the corner. */
  .cta__mark {
    position: absolute;
    left: clamp(-7rem, -6vw, -3rem);
    bottom: clamp(-7rem, -6vw, -3rem);
    z-index: -1;
    width: clamp(12rem, 24vw, 20rem);
    aspect-ratio: 1;
    color: color-mix(in srgb, var(--c-dark) 7%, transparent);
    animation: cta-spin 60s linear infinite;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .cta__title {
    max-width: 18ch;
  }

  .cta__title :global(.cta__star) {
    display: inline-block;
    vertical-align: super;
  }

  .cta__box :global(.arrow-btn) {
    flex: none;
  }
</style>
