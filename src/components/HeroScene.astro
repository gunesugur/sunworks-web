---
/**
 * Decorative hero card: a tiny site builds itself in a browser window, from wireframe to finished
 * page with the brand's sun rising in it, then goes live. Pure CSS, one 9s loop; with reduced
 * motion it shows the finished page.
 */
interface Props {
  /** Three phase labels: design, build, live. */
  labels: readonly string[];
}
const { labels } = Astro.props;
---

<div class="scene scheme-invert" aria-hidden="true">
  <div class="scene__in">
  <div class="scene__chrome">
    <span class="scene__dot"></span><span class="scene__dot"></span><span class="scene__dot"></span>
    <span class="scene__url"><span class="scene__typed">sunworks.studio</span></span>
  </div>
  <div class="scene__canvas">
    <div class="scene__copy">
      <span class="scene__bar scene__bar--title"></span>
      <span class="scene__bar"></span>
      <span class="scene__bar scene__bar--short"></span>
      <span class="scene__cta"></span>
    </div>
    <div class="scene__art">
      <span class="scene__sun"></span>
      <span class="scene__ground"></span>
    </div>
    <svg class="scene__cursor" viewBox="0 0 16 20" width="16" height="20">
      <path d="M1 1l13 9.5-6 .8 3.4 6.6-2.6 1.3-3.4-6.6L1 17z"></path>
    </svg>
  </div>
  <span class="scene__status">
    <span class="scene__led"></span>
    <span class="scene__labels">{labels.map((l) => <span>{l}</span>)}</span>
  </span>
  </div>
</div>

<style>
  .scene {
    container-type: inline-size;
    border-radius: var(--r-card);
    overflow: hidden;
  }

  .scene__in {
    --loop: 9s;
    --wire: color-mix(in srgb, var(--c-dark) 55%, transparent);
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 3.5cqw;
    aspect-ratio: 343 / 229;
    padding: 4.5cqw;
    background: var(--c-light);
    color: var(--c-dark);
  }

  /* Browser chrome */
  .scene__chrome {
    display: flex;
    align-items: center;
    gap: 1.8cqw;
  }

  .scene__dot {
    width: 2.4cqw;
    height: 2.4cqw;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-dark) 28%, transparent);
  }

  .scene__url {
    display: flex;
    align-items: center;
    flex: 1;
    height: 7cqw;
    margin-left: 1.5cqw;
    padding-inline: 3cqw;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--c-dark) 9%, transparent);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 3.2cqw;
    font-weight: 600;
  }

  .scene__typed {
    display: inline-block;
    width: 15ch;
    overflow: hidden;
    white-space: nowrap;
    border-right: 1.5px solid var(--c-accent);
    animation: scene-type var(--loop) steps(15) infinite;
  }

  /* Page being built */
  .scene__canvas {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4cqw;
    padding: 5cqw;
    border-radius: 4cqw;
    background: color-mix(in srgb, var(--c-dark) 6%, transparent);
  }

  .scene__copy {
    display: grid;
    align-content: center;
    gap: 2.6cqw;
  }

  .scene__bar {
    height: 2.4cqw;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--c-dark) 55%, transparent);
    transform-origin: left;
    animation: scene-bar var(--loop) var(--ease-out) infinite;
  }

  .scene__bar--title {
    height: 4.2cqw;
    background: var(--c-dark);
  }

  .scene__bar:nth-child(2) {
    width: 86%;
    animation-delay: 0.15s;
  }

  .scene__bar--short {
    width: 58%;
    animation-delay: 0.3s;
  }

  .scene__cta {
    width: 46%;
    height: 7.5cqw;
    margin-top: 1.6cqw;
    border: 1.5px dashed var(--wire);
    border-radius: var(--r-pill);
    animation: scene-fill var(--loop) var(--ease-out) infinite;
  }

  .scene__art {
    position: relative;
    border: 1.5px dashed var(--wire);
    border-radius: 3cqw;
    overflow: hidden;
    animation: scene-frame var(--loop) var(--ease-out) infinite;
  }

  .scene__sun {
    position: absolute;
    left: 50%;
    top: 72%;
    width: 48%;
    aspect-ratio: 1;
    margin-left: -24%;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 0 3cqw color-mix(in srgb, var(--c-accent) 18%, transparent);
    animation: scene-sun var(--loop) var(--ease-out) infinite;
  }

  .scene__ground {
    position: absolute;
    inset: 72% 0 0;
    border-top: 0.6cqw solid var(--c-dark);
    background: var(--c-light);
  }

  .scene__cursor {
    position: absolute;
    left: 0;
    top: 0;
    width: 5.2cqw;
    height: auto;
    fill: var(--c-dark);
    stroke: var(--c-light);
    stroke-width: 1.2;
    offset-rotate: 0deg;
    animation: scene-cursor var(--loop) var(--ease-in-out) infinite;
  }

  /* Status chip: design → build → live */
  .scene__status {
    position: absolute;
    right: 7cqw;
    bottom: 7cqw;
    display: inline-flex;
    align-items: center;
    gap: 1.8cqw;
    padding: 1.4cqw 3.2cqw 1.4cqw 2.6cqw;
    border-radius: var(--r-pill);
    background: var(--c-dark);
    color: var(--c-light);
    font-size: 3.4cqw;
    font-weight: 700;
  }

  .scene__led {
    width: 2.2cqw;
    height: 2.2cqw;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-light) 45%, transparent);
    animation: scene-led var(--loop) steps(1) infinite;
  }

  .scene__labels {
    display: grid;
  }

  .scene__labels > span {
    grid-area: 1 / 1;
    opacity: 0;
    animation: scene-label var(--loop) var(--ease-out) infinite;
  }

  .scene__labels > span:nth-child(2) {
    animation-delay: calc(var(--loop) / 3);
  }

  .scene__labels > span:nth-child(3) {
    animation-delay: calc(var(--loop) / 3 * 2);
  }

  /* 0–33%: wireframe · 33–66%: build · 66–100%: click and go live */
  @keyframes scene-type {
    0%,
    2% {
      width: 0;
    }

    18%,
    100% {
      width: 15ch;
    }
  }

  @keyframes scene-bar {
    0%,
    4% {
      transform: scaleX(0);
    }

    16%,
    96% {
      transform: none;
      opacity: 1;
    }

    100% {
      transform: none;
      opacity: 0;
    }
  }

  @keyframes scene-fill {
    0%,
    34% {
      background: transparent;
      border-color: var(--wire);
      transform: none;
    }

    40% {
      background: var(--c-accent);
      border-color: transparent;
      transform: scale(1.08);
    }

    44%,
    70% {
      background: var(--c-accent);
      border-color: transparent;
      transform: none;
    }

    73% {
      background: var(--c-accent);
      border-color: transparent;
      transform: scale(0.9);
    }

    77%,
    96% {
      background: var(--c-accent);
      border-color: transparent;
      transform: none;
    }

    100% {
      background: transparent;
      border-color: var(--wire);
    }
  }

  @keyframes scene-frame {
    0%,
    34% {
      background: transparent;
      border-color: var(--wire);
    }

    42%,
    96% {
      background: color-mix(in srgb, var(--c-dark) 8%, transparent);
      border-color: transparent;
    }

    100% {
      background: transparent;
      border-color: var(--wire);
    }
  }

  @keyframes scene-sun {
    0%,
    36% {
      transform: translate3d(0, 70%, 0);
    }

    58%,
    94% {
      transform: translate3d(0, -42%, 0);
    }

    100% {
      transform: translate3d(0, 70%, 0);
    }
  }

  @keyframes scene-cursor {
    0%,
    52% {
      transform: translate3d(34cqw, 30cqw, 0);
      opacity: 0;
    }

    56% {
      opacity: 1;
    }

    70% {
      transform: translate3d(14cqw, 22cqw, 0);
    }

    73% {
      transform: translate3d(14cqw, 22cqw, 0) scale(0.85);
    }

    76%,
    86% {
      transform: translate3d(14cqw, 22cqw, 0);
      opacity: 1;
    }

    92%,
    100% {
      transform: translate3d(30cqw, 34cqw, 0);
      opacity: 0;
    }
  }

  @keyframes scene-led {
    0% {
      background: color-mix(in srgb, var(--c-light) 45%, transparent);
    }

    73% {
      background: var(--c-accent);
    }
  }

  @keyframes scene-label {
    0% {
      opacity: 0;
      transform: translate3d(0, 60%, 0);
    }

    3%,
    30% {
      opacity: 1;
      transform: none;
    }

    33.3%,
    100% {
      opacity: 0;
      transform: translate3d(0, -60%, 0);
    }
  }

  /* Reduced motion: the finished, live page. */
  @media (prefers-reduced-motion: reduce) {
    .scene *,
    .scene__labels > span {
      animation: none !important;
    }
  }

  :global(html[data-motion='reduce']) .scene *,
  :global(html[data-motion='reduce']) .scene__labels > span {
    animation: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .scene__cta {
      background: var(--c-accent);
      border-color: transparent;
    }

    .scene__art {
      background: color-mix(in srgb, var(--c-dark) 8%, transparent);
      border-color: transparent;
    }

    .scene__sun {
      transform: translate3d(0, -42%, 0);
    }

    .scene__cursor {
      opacity: 0;
    }

    .scene__led {
      background: var(--c-accent);
    }

    .scene__labels > span:last-child {
      opacity: 1;
    }
  }

  :global(html[data-motion='reduce']) .scene__cta {
    background: var(--c-accent);
    border-color: transparent;
  }

  :global(html[data-motion='reduce']) .scene__art {
    background: color-mix(in srgb, var(--c-dark) 8%, transparent);
    border-color: transparent;
  }

  :global(html[data-motion='reduce']) .scene__sun {
    transform: translate3d(0, -42%, 0);
  }

  :global(html[data-motion='reduce']) .scene__cursor {
    opacity: 0;
  }

  :global(html[data-motion='reduce']) .scene__led {
    background: var(--c-accent);
  }

  :global(html[data-motion='reduce']) .scene__labels > span:last-child {
    opacity: 1;
  }
</style>
