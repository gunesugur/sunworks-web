---
/** Light/dark switch: the logo's sun sets below the horizon and a crescent rises (scripts/theme-toggle.ts). */
import type { Locale } from '@/content/schema';
import { t } from '@/i18n/ui';

interface Props {
  lang: Locale;
}
const s = t(Astro.props.lang);
---

<button type="button" class="theme-toggle" data-theme-toggle data-label-dark={s.themeToDark} data-label-light={s.themeToLight}>
  <span class="sr-only" data-theme-label>{s.themeToggle}</span>
  <svg class="theme-toggle__art" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id="tt-sky"><rect width="24" height="17.4"></rect></clipPath>
      <mask id="tt-bite">
        <rect width="24" height="24" fill="#fff"></rect>
        <circle cx="15.6" cy="6.4" r="4.3" fill="#000"></circle>
      </mask>
    </defs>
    <g clip-path="url(#tt-sky)">
      <path class="theme-toggle__sun" d="M6 17.4a6 6 0 0 1 12 0z"></path>
      <circle class="theme-toggle__moon" cx="12.4" cy="9" r="5.2" mask="url(#tt-bite)"></circle>
    </g>
    <g class="theme-toggle__stars">
      <path d="M19.4 2.6v3M17.9 4.1h3" stroke-width="1.2" stroke-linecap="round"></path>
      <circle cx="5.2" cy="5.6" r="0.9"></circle>
    </g>
    <path class="theme-toggle__horizon" d="M3 19h18" stroke-width="1.6" stroke-linecap="round"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    padding: 0;
    border: var(--stroke) solid var(--c-dark);
    border-radius: 50%;
    background: transparent;
    color: var(--c-dark);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) ease,
      transform var(--dur) var(--ease-out);
  }

  .theme-toggle:hover {
    background: var(--c-band);
  }

  .theme-toggle:active {
    transform: scale(0.94);
  }

  .theme-toggle__sun {
    fill: var(--c-accent);
    transition: transform 0.7s var(--ease-out);
  }

  .theme-toggle__moon {
    fill: currentColor;
    transform: translate3d(0, 11px, 0);
    opacity: 0;
    transition:
      transform 0.7s var(--ease-out) 0.08s,
      opacity 0.4s ease 0.08s;
  }

  .theme-toggle__stars {
    fill: currentColor;
    stroke: currentColor;
    opacity: 0;
    transform: scale(0.4);
    transform-origin: 12px 5px;
    transition:
      opacity 0.4s ease,
      transform 0.6s var(--ease-out);
  }

  .theme-toggle__horizon {
    stroke: currentColor;
  }

  /* Hover previews the switch: in light mode the sun dips and the crescent peeks over the horizon;
     in dark mode the sun climbs back up while the moon sinks. */
  :global(html:not([data-theme='dark'])) .theme-toggle:hover .theme-toggle__sun {
    transform: translate3d(0, 5px, 0);
  }

  :global(html:not([data-theme='dark'])) .theme-toggle:hover .theme-toggle__moon {
    transform: translate3d(0, 4px, 0);
    opacity: 1;
  }

  :global(html:not([data-theme='dark'])) .theme-toggle:hover .theme-toggle__stars {
    opacity: 0.7;
    transform: scale(0.8);
  }

  :global(html[data-theme='dark']) .theme-toggle__sun {
    transform: translate3d(0, 9px, 0);
  }

  :global(html[data-theme='dark']) .theme-toggle__moon {
    transform: none;
    opacity: 1;
  }

  :global(html[data-theme='dark']) .theme-toggle__stars {
    opacity: 1;
    transform: none;
    transition-delay: 0.25s;
  }

  :global(html[data-theme='dark']) .theme-toggle:hover .theme-toggle__sun {
    transform: translate3d(0, -1px, 0);
  }

  :global(html[data-theme='dark']) .theme-toggle:hover .theme-toggle__moon {
    transform: translate3d(0, 7px, 0);
    opacity: 0.5;
  }

  :global(html[data-theme='dark']) .theme-toggle:hover .theme-toggle__stars {
    opacity: 0;
    transform: scale(0.6);
    transition-delay: 0s;
  }
</style>
