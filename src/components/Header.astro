---
import type { Locale, Navigation } from '@/content/schema';
import { cleanPath, otherLocale, routes } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import Button from './Button.astro';
import Logo from './Logo.astro';

interface Props {
  lang: Locale;
  nav: Navigation;
  siteName: string;
  altHref: string;
}
const { lang, nav, siteName, altHref } = Astro.props;
const s = t(lang);
const path = cleanPath(Astro.url.pathname);
const isActive = (href: string) => {
  if (href === routes.home[lang]) return path === href;
  return path === href || path.startsWith(`${href}/`);
};
const altLang = otherLocale(lang);
---

<header class="site-header" transition:name="site-header" data-header>
  <div class="container site-header__inner">
    <Logo href={routes.home[lang]} label={`${siteName} — ${s.home}`} />

    <nav class="site-nav" aria-label={s.mainNav} id="site-nav" data-nav>
      <ul class="site-nav__list">
        {
          nav.header.map((item) => (
            <li>
              <a href={item.href} class="site-nav__link" aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-nav__extra">
        <a href={altHref} class="lang" hreflang={altLang}>{s.langSwitchShort}<span class="sr-only" lang={altLang}> — {s.langSwitchLabel}</span></a>
        <Button href={nav.cta.href} variant="outline">{nav.cta.label}</Button>
      </div>
    </nav>

    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
      data-label-open={s.menu}
      data-label-close={s.closeMenu}
    >
      <span class="sr-only" data-menu-label>{s.menu}</span>
      <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 40;
    padding-block: 1.75rem;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    gap: 2rem;
    margin-left: clamp(2rem, 10vw, 11rem);
  }

  .site-nav__list {
    display: flex;
    gap: clamp(1.5rem, 3.5vw, 3.75rem);
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    position: relative;
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--c-muted);
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur) var(--ease-out);
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current='page'] {
    color: var(--c-dark);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-nav__extra {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .lang {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    font-size: var(--fs-xs);
    font-weight: 700;
    text-decoration: none;
    transition: background-color var(--dur-fast) ease;
  }

  .lang:hover {
    background: var(--c-band);
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 900px) {
    .site-header {
      padding-block: 1rem;
    }

    .menu-toggle {
      position: relative;
      z-index: 2;
      display: inline-grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border: var(--stroke) solid var(--c-dark);
      border-radius: 50%;
      background: var(--c-light);
      cursor: pointer;
    }

    .menu-toggle__bars {
      display: grid;
      gap: 6px;
      width: 18px;
    }

    .menu-toggle__bars span {
      display: block;
      height: 1.6px;
      border-radius: 2px;
      background: currentColor;
      transition: transform var(--dur) var(--ease-out);
    }

    .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:first-child {
      transform: translate3d(0, 3.8px, 0) rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:last-child {
      transform: translate3d(0, -3.8px, 0) rotate(-45deg);
    }

    .site-nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      gap: 2.5rem;
      margin: 0;
      padding: 6rem var(--gutter) 3rem;
      background: var(--c-light);
      visibility: hidden;
      opacity: 0;
      transform: translate3d(0, -12px, 0);
      transition:
        opacity var(--dur) var(--ease-out),
        transform var(--dur) var(--ease-out),
        visibility 0s linear var(--dur);
    }

    .site-nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity var(--dur) var(--ease-out),
        transform var(--dur) var(--ease-out);
    }

    .site-nav__list {
      flex-direction: column;
      gap: 0.5rem;
    }

    .site-nav__link {
      font-size: clamp(2rem, 8vw, 2.75rem);
      font-weight: 500;
      color: var(--c-dark);
    }

    .site-nav__link::after {
      display: none;
    }

    .site-nav__extra {
      justify-content: space-between;
    }
  }
</style>
