---
import type { Locale, Navigation } from '@/content/schema';
import { getNavigation } from '@/lib/cms';
import { cleanPath, otherLocale, routes } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import Button from './Button.astro';
import Logo from './Logo.astro';
import Swap from './Swap.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Locale;
  nav: Navigation;
  siteName: string;
  altHref: string;
}
const { lang, nav, siteName, altHref } = Astro.props;
const s = t(lang);
const path = cleanPath(Astro.url.pathname);
const isActive = (href: string) => {
  if (href === routes.home[lang]) return path === href;
  return path === href || path.startsWith(`${href}/`);
};
const altLang = otherLocale(lang);
// Labels of the other language, index-aligned, so every label keeps the width of its longer version.
const altNav = await getNavigation(altLang);
---

<header class="site-header" transition:name="site-header" data-header>
  <div class="container site-header__inner">
    <Logo href={routes.home[lang]} label={`${siteName} — ${s.home}`} />

    <nav class="site-nav" aria-label={s.mainNav} id="site-nav" data-nav>
      <ul class="site-nav__list">
        {
          nav.header.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} class="site-nav__link" data-index={String(i + 1).padStart(2, '0')} aria-current={isActive(item.href) ? 'page' : undefined}>
                <Swap text={item.label} alt={altNav.header[i]?.label} class="site-nav__label" />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-nav__extra">
        <Button href={nav.cta.href} variant="outline"><Swap text={nav.cta.label} alt={altNav.cta.label} /></Button>
      </div>
    </nav>

    <div class="menu-layers" aria-hidden="true"><span></span><span></span></div>

    <!-- The language switch sits with the theme toggle so neither moves when the CTA's label length changes. -->
    <div class="site-header__tools">
      <a href={altHref} class="lang" hreflang={altLang}>{s.langSwitchShort}<span class="sr-only" lang={altLang}> — {s.langSwitchLabel}</span></a>
      <ThemeToggle lang={lang} />
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        data-menu-toggle
        data-label-open={s.menu}
        data-label-close={s.closeMenu}
      >
        <span class="sr-only" data-menu-label>{s.menu}</span>
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<style>
  /* Sticky: glass backdrop once the page scrolls, slides away on scroll down (scripts/header.ts).
     The backdrop lives on ::before so the mobile nav (position: fixed) keeps the viewport as its box. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-block: 1.75rem;
    transition:
      padding-block var(--dur) var(--ease-out),
      margin-bottom var(--dur) var(--ease-out),
      transform 0.55s var(--ease-out);
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-bottom: 1px solid var(--c-line);
    background: color-mix(in srgb, var(--c-light) 90%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    backdrop-filter: blur(20px) saturate(1.4);
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }

  /* The bar slims down; margin-bottom takes the freed space so nothing below it moves (no CLS). */
  .site-header.is-scrolled {
    padding-block: 0.8rem;
    margin-bottom: 1.9rem;
  }

  .site-header.is-scrolled::before {
    opacity: 1;
  }

  .site-header.is-hidden {
    transform: translate3d(0, -110%, 0);
  }

  .site-header__inner > :global(.logo) {
    position: relative;
    z-index: 2;
  }

  .site-header__tools {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    gap: 2rem;
    margin-left: clamp(2rem, 10vw, 11rem);
  }

  .site-nav__list {
    display: flex;
    gap: clamp(1.5rem, 3.5vw, 3.75rem);
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    position: relative;
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--c-muted);
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-fast) ease;
  }

  /* Underline the visible label only; the Swap ghost may make the link wider than its text. */
  .site-nav__link :global(.swap__text) {
    position: relative;
  }

  .site-nav__link :global(.swap__text)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.4rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur) var(--ease-out);
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current='page'] {
    color: var(--c-dark);
  }

  .site-nav__link:hover :global(.swap__text)::after,
  .site-nav__link[aria-current='page'] :global(.swap__text)::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-nav__extra {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .lang {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    font-size: var(--fs-xs);
    font-weight: 700;
    text-decoration: none;
    transition: background-color var(--dur-fast) ease;
  }

  .lang:hover {
    background: var(--c-band);
  }

  .menu-toggle,
  .menu-layers {
    display: none;
  }

  @media (min-width: 901px) and (max-width: 1200px) {
    .site-header__inner,
    .site-nav {
      gap: 1rem;
    }

    .site-nav {
      margin-left: 1.5rem;
    }

    .site-nav__list {
      gap: 1.4rem;
    }

    .site-nav__extra {
      gap: 0.75rem;
    }
  }

  @media (max-width: 900px) {
    .site-header {
      padding-block: 1rem;
    }

    .site-header.is-scrolled {
      padding-block: 0.6rem;
      margin-bottom: 0.8rem;
    }

    .menu-toggle {
      position: relative;
      z-index: 2;
      display: inline-grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border: var(--stroke) solid var(--c-dark);
      border-radius: 50%;
      background: var(--c-light);
      cursor: pointer;
    }

    .menu-toggle__bars {
      display: grid;
      gap: 6px;
      width: 18px;
    }

    .menu-toggle__bars span {
      display: block;
      height: 1.6px;
      border-radius: 2px;
      background: currentColor;
      transition: transform var(--dur) var(--ease-out);
    }

    .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:first-child {
      transform: translate3d(0, 3.8px, 0) rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:last-child {
      transform: translate3d(0, -3.8px, 0) rotate(-45deg);
    }

    /* Staggered menu: an accent layer, then an ink layer, then the panel sweep in from the right;
       the links rise one after another. Closing runs the same sweep back out, faster. */
    .menu-layers,
    .menu-layers span {
      position: fixed;
      inset: 0;
    }

    .menu-layers {
      z-index: 0;
      display: block;
      pointer-events: none;
    }

    .menu-layers span {
      transform: translate3d(100%, 0, 0);
      transition: transform 0.45s var(--ease-in-out) 0.12s;
    }

    .menu-layers span:first-child {
      background: var(--c-accent);
      transition-delay: 0.18s;
    }

    .menu-layers span:last-child {
      background: var(--c-dark);
    }

    .site-header:has(.site-nav.is-open) .menu-layers span {
      transform: none;
      transition: transform 0.55s var(--ease-out);
    }

    .site-header:has(.site-nav.is-open) .menu-layers span:last-child {
      transition-delay: 0.07s;
    }

    .site-nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      gap: 3rem;
      margin: 0;
      padding: 6rem var(--gutter) 3rem;
      background: var(--c-light);
      visibility: hidden;
      /* The panel is wiped in with a clip, not moved: its links never drift sideways. */
      clip-path: inset(0 0 0 100%);
      transition:
        clip-path 0.45s var(--ease-in-out),
        visibility 0s linear 0.6s;
    }

    .site-nav.is-open {
      visibility: visible;
      clip-path: inset(0);
      transition: clip-path 0.5s var(--ease-in-out) 0.14s;
    }

    .site-nav__list {
      flex-direction: column;
      gap: 0.25rem;
    }

    .site-nav__link {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      font-size: clamp(2.5rem, 11vw, 4rem);
      font-weight: 600;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--c-dark);
      /* Each label is revealed bottom-up in place, after the panel has settled; the text itself
         never moves, so there is nothing to settle or re-snap once it is visible. */
      clip-path: inset(100% 0 0 0);
      transition: clip-path 0.25s var(--ease-in-out);
    }

    .site-nav.is-open .site-nav__link {
      clip-path: inset(-0.5rem);
      transition: clip-path 0.5s var(--ease-in-out) calc(0.6s + var(--i) * 0.07s);
    }

    .site-nav__link[aria-current='page'] {
      color: var(--c-dark);
    }

    /* Menu numbers are generated content (empty alt text), so they stay out of the link's name. */
    .site-nav__link::before {
      content: attr(data-index);
      content: attr(data-index) / '';
      display: block;
      min-width: 1.6em;
      padding-top: 0.55em;
      color: var(--c-accent);
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    .site-nav__link :global(.swap__text)::after {
      display: none;
    }

    /* One language at a time in the full-screen menu: no ghost width, labels start on one line. */
    .site-nav__link :global(.swap__ghost) {
      display: none;
    }

    .site-nav__extra {
      opacity: 0;
      transform: translate3d(0, 12px, 0);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    .site-nav.is-open .site-nav__extra {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.5s ease 0.7s,
        transform 0.6s var(--ease-out) 0.7s;
    }

    .site-nav__extra {
      justify-content: space-between;
    }
  }
</style>
