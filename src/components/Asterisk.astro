---
/** The brand accent: a six-armed asterisk. Decorative only. */
interface Props {
  size?: number | string;
  class?: string;
}
const { size = '1em', class: cls } = Astro.props;
---

<svg class:list={['asterisk', cls]} width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  <g stroke="currentColor" stroke-width="5.2" stroke-linecap="round">
    <path d="M20 5v30"></path>
    <path d="M7 12.5l26 15"></path>
    <path d="M7 27.5l26-15"></path>
  </g>
</svg>

<style>
  .asterisk {
    display: inline-block;
    flex: none;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  :global(:hover) > .asterisk,
  :global(:focus-visible) > .asterisk {
    transform: rotate(120deg);
  }
</style>
