---
import Icon from './Icon.astro';

interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'outline' | 'solid' | 'light' | 'accent';
  size?: 'md' | 'lg';
  class?: string;
  [key: `data-${string}`]: string | undefined;
}
const { href, type = 'button', variant = 'outline', size = 'md', class: cls, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, `btn--${size}`, cls];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <span class="btn__label">
        <slot />
      </span>
      <span class="btn__arrow" aria-hidden="true">
        <Icon name="arrow" size={14} />
        <Icon name="arrow" size={14} />
      </span>
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <span class="btn__label">
        <slot />
      </span>
      <span class="btn__arrow" aria-hidden="true">
        <Icon name="arrow" size={14} />
        <Icon name="arrow" size={14} />
      </span>
    </button>
  )
}

<style>
  .btn {
    --btn-fg: var(--c-dark);
    --btn-bg: transparent;
    --btn-border: var(--c-dark);
    --btn-hover-fg: var(--c-light);
    --btn-hover-bg: var(--c-dark);
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 44px;
    padding: 0.55rem 1.1rem 0.55rem 1.35rem;
    border: var(--stroke) solid var(--btn-border);
    border-radius: var(--r-pill);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    isolation: isolate;
    overflow: hidden;
    transition:
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  /* Fill wipes up from the bottom (transform only). */
  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--btn-hover-bg);
    border-radius: inherit;
    transform: translate3d(0, 101%, 0);
    transition: transform var(--dur) var(--ease-out);
  }

  .btn:hover,
  .btn:focus-visible {
    color: var(--btn-hover-fg);
  }

  .btn:hover::before,
  .btn:focus-visible::before {
    transform: none;
  }

  .btn--lg {
    min-height: 52px;
    padding: 0.8rem 1.4rem 0.8rem 1.75rem;
    font-size: var(--fs-small);
  }

  .btn--solid {
    --btn-fg: var(--c-light);
    --btn-bg: var(--c-dark);
    --btn-hover-fg: var(--c-on-accent);
    --btn-hover-bg: var(--c-accent);
  }

  .btn--accent {
    --btn-fg: var(--c-on-accent);
    --btn-bg: var(--c-accent);
    --btn-border: var(--c-accent);
    --btn-hover-fg: var(--c-dark);
    --btn-hover-bg: var(--c-light);
  }

  .btn--light {
    --btn-fg: var(--c-light);
    --btn-border: var(--c-light);
    --btn-hover-fg: var(--c-dark);
    --btn-hover-bg: var(--c-light);
  }

  .btn__arrow {
    position: relative;
    display: inline-grid;
    width: 14px;
    height: 14px;
    overflow: hidden;
  }

  .btn__arrow :global(.icon) {
    grid-area: 1 / 1;
    transition: transform var(--dur) var(--ease-out);
  }

  .btn__arrow :global(.icon:last-child) {
    transform: translate3d(-120%, 120%, 0);
  }

  .btn:hover .btn__arrow :global(.icon:first-child),
  .btn:focus-visible .btn__arrow :global(.icon:first-child) {
    transform: translate3d(120%, -120%, 0);
  }

  .btn:hover .btn__arrow :global(.icon:last-child),
  .btn:focus-visible .btn__arrow :global(.icon:last-child) {
    transform: none;
  }

  .btn[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
</style>
