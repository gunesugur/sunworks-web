---
/** Hand-drawn 24px stroke icons (no third-party icon sets). */
import type { IconName } from '@/content/schema';

type Name = IconName | 'arrow' | 'menu' | 'close' | 'mail' | 'pin' | 'rss';
interface Props {
  name: Name;
  size?: number;
  class?: string;
}
const { name, size = 24, class: cls } = Astro.props;

const paths: Record<Name, string> = {
