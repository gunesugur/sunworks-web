---
import { getImage } from 'astro:assets';
import type { ImageField } from '@/content/schema';
import { resolveDarkImage, resolveImage, type ResolvedImage } from '@/lib/images';

interface Props {
  image: ImageField;
  widths: number[];
  sizes: string;
  class?: string;
  priority?: boolean;
  alt?: string;
}
const { image, widths, sizes, class: cls, priority = false, alt } = Astro.props;
const light = resolveImage(image);
const dark = resolveDarkImage(image);

/** AVIF first (smallest), WebP for the rest; quality tuned per codec to look the same. */
const FORMATS = [
  { format: 'avif', type: 'image/avif', quality: 58 },
  { format: 'webp', type: 'image/webp', quality: 80 },
] as const;

const build = async (img: ResolvedImage) =>
  Promise.all(
    FORMATS.map(async ({ format, type, quality }) => {
      const size = img.kind === 'local' ? {} : { width: img.width, height: img.height };
      const out = await getImage({ src: img.src, ...size, widths, format, quality });
      return { type, srcset: out.srcSet.attribute, src: out.src, attrs: out.attributes };
    }),
  );

const [lightAvif, lightWebp] = await build(light);
const darkSets = dark ? await build(dark) : [];
if (!lightAvif || !lightWebp) throw new Error('Image formats missing');
---

<picture>
  {darkSets.map((s) => <source data-dark media="(prefers-color-scheme: dark)" type={s.type} srcset={s.srcset} sizes={sizes} />)}
  <source type={lightAvif.type} srcset={lightAvif.srcset} sizes={sizes} />
  <img
    src={lightWebp.src}
    srcset={lightWebp.srcset}
    sizes={sizes}
    width={lightWebp.attrs['width']}
    height={lightWebp.attrs['height']}
    alt={alt ?? light.alt}
    class={cls}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
</picture>
