const productHref = routes.kartela[lang];
---

<Base
  lang={lang}
  title={copy.seo}
  description={copy.description}
  alternates={{ tr: routes.kartelaDemo.tr, en: routes.kartelaDemo.en }}
>
  <PageHeader lang={lang} title={copy.title} intro={copy.intro} crumbs={[{ label: copy.crumb, href: productHref }]}>
    <div class="kt-head-links">
      <Button href={productHref} variant="outline">{copy.backToProduct}</Button>
    </div>
  </PageHeader>

  <section class="container kt" data-kartela data-lang={lang} data-strings={JSON.stringify(js)} aria-label={copy.title}>
    <noscript><p class="kt-note">{copy.noscript}</p></noscript>
    <template data-kt-icon="key"><Icon name="key" size={16} /></template>
    <template data-kt-icon="chat"><Icon name="chat" size={16} /></template>
    <template data-kt-icon="close"><Icon name="close" size={16} /></template>

    <div class="kt-toolbar">
      <div class="kt-tabs" role="tablist" aria-label={copy.views}>
        <button class="kt-tab" type="button" role="tab" id="kt-tab-catalog" aria-controls="kt-view-catalog" aria-selected="true" data-kt-tab="catalog">
          {copy.tabCatalog}
        </button>
        <button class="kt-tab" type="button" role="tab" id="kt-tab-panel" aria-controls="kt-view-panel" aria-selected="false" tabindex="-1" data-kt-tab="panel">
          {copy.tabPanel}
        </button>
        <button class="kt-tab" type="button" role="tab" id="kt-tab-pdf" aria-controls="kt-view-pdf" aria-selected="false" tabindex="-1" data-kt-tab="pdf">
          {copy.tabPdf}
        </button>
      </div>
      <div class="kt-plan" role="group" aria-labelledby="kt-plan-label">
        <span class="kt-label" id="kt-plan-label">{copy.plan}</span>
        <div class="kt-seg">
          <button type="button" data-kt-plan="free" aria-pressed="true">{copy.free}</button>
          <button type="button" data-kt-plan="pro" aria-pressed="false">{copy.pro}</button>
        </div>
        <button type="button" class="kt-link" data-kt-reset>{copy.reset}</button>
      </div>
    </div>

    <!-- CATALOG: what a dealer sees -->
    <div class="kt-view" id="kt-view-catalog" role="tabpanel" aria-labelledby="kt-tab-catalog">
      <div class="kt-shop">
        <header class="kt-firm">
          <span class="kt-mark" data-kt-mark aria-hidden="true"></span>
          <div class="kt-firm__text">
            <h2 class="kt-firm__name" data-kt-name></h2>
            <p class="kt-firm__meta"><span data-kt-city></span><span>{copy.vatNote}</span><span data-kt-updated></span></p>
          </div>
          <a class="kt-pill kt-pill--line" data-kt-wa href="#" target="_blank" rel="noopener">
            <Icon name="chat" size={18} />
            {copy.writeWa}
          </a>
        </header>

        <div class="kt-viewer">
          <div class="kt-viewer__row">
            <span class="kt-label">{copy.whoLooks}</span>
            <span class="kt-hint">{copy.whoHint}</span>
          </div>
          <div class="kt-chips" data-kt-viewers></div>
          <form class="kt-login" data-kt-login>
            <label for="kt-code" class="kt-label">{copy.dealerCode}</label>
            <input id="kt-code" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder={copy.codePlaceholder} />
            <button type="submit" class="kt-pill kt-pill--line">{copy.signIn}</button>
          </form>
          <p class="kt-who" data-kt-who aria-live="polite"></p>
        </div>

        <div class="kt-filters">
          <div class="kt-chips" data-kt-cats role="group" aria-label={copy.categories}></div>
          <label class="kt-search">
            <Icon name="search" size={18} />
            <span class="sr-only">{copy.searchLabel}</span>
            <input type="search" data-kt-q placeholder={copy.search} />
          </label>
        </div>

        <div class="kt-grid" data-kt-grid></div>
        <p class="kt-hint" data-kt-empty hidden>{copy.empty}</p>
        <p class="kt-watermark" data-kt-wm>
          <span class="kt-watermark__logo">kartela</span>
          <span>{copy.watermark}</span>
        </p>
      </div>

      <div class="kt-orderbar" data-kt-orderbar hidden>
        <span data-kt-bar></span>
        <button type="button" class="kt-pill kt-pill--accent" data-kt-open>{copy.review}</button>
      </div>

      <dialog class="kt-dialog" data-kt-dialog aria-labelledby="kt-order-title">
        <div class="kt-dialog__body">
          <div class="kt-dialog__head">
            <h2 class="h3" id="kt-order-title">{copy.orderTitle}</h2>
            <button type="button" class="kt-icon-btn" data-kt-close aria-label={copy.close}><Icon name="close" size={18} /></button>
          </div>
          <div class="kt-lines" data-kt-lines></div>
          <p class="kt-total"><span class="kt-label">{copy.total}</span><b data-kt-total></b></p>
          <div class="kt-field">
            <span class="kt-label" id="kt-msg-label">{copy.waMessage}</span>
            <pre class="kt-msg" data-kt-msg aria-labelledby="kt-msg-label" tabindex="0"></pre>
          </div>
          <div class="kt-actions">
            <a class="kt-pill kt-pill--accent" data-kt-send href="#" target="_blank" rel="noopener"><Icon name="chat" size={18} />{copy.openWa}</a>
            <button type="button" class="kt-pill kt-pill--line" data-kt-copy>{copy.copyMsg}</button>
            <span class="kt-hint" data-kt-copied aria-live="polite"></span>
          </div>
          <p class="kt-hint">{copy.orderNote}</p>
        </div>
      </dialog>
    </div>

    <!-- PANEL: what the wholesaler manages -->
    <div class="kt-view" id="kt-view-panel" role="tabpanel" aria-labelledby="kt-tab-panel" hidden>
      <div class="kt-panel">
        <div class="kt-col">
          <section class="kt-box" aria-labelledby="kt-firm-h">
            <h2 class="kt-box__title" id="kt-firm-h">{copy.firm}</h2>
            <div class="kt-field"><label for="kt-f-name">{copy.firmName}</label><input id="kt-f-name" type="text" data-kt-firm="name" /></div>
            <div class="kt-two">
              <div class="kt-field"><label for="kt-f-city">{copy.city}</label><input id="kt-f-city" type="text" data-kt-firm="city" /></div>
              <div class="kt-field"><label for="kt-f-phone">{copy.phone}</label><input id="kt-f-phone" type="tel" inputmode="tel" data-kt-firm="phone" /></div>
            </div>
            <div class="kt-field">
              <span class="kt-field__label">{copy.logo}</span>
              <div class="kt-logo">
                <span class="kt-mark" data-kt-mark aria-hidden="true"></span>
                <label class="kt-pill kt-pill--line kt-file">
                  {copy.uploadLogo}
                  <input type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" data-kt-logo class="sr-only" />
                </label>
                <button type="button" class="kt-link" data-kt-logo-rm hidden>{copy.removeLogo}</button>
              </div>
              <p class="kt-hint" data-kt-logo-msg aria-live="polite">{copy.logoHint}</p>
            </div>
            <div class="kt-field">
              <label for="kt-f-color">{copy.brandColor}</label>
              <div class="kt-color"><input id="kt-f-color" type="color" data-kt-color /><span data-kt-color-v></span></div>
            </div>
          </section>

          <section class="kt-box" aria-labelledby="kt-plans-h">
            <h2 class="kt-box__title" id="kt-plans-h">{copy.plans}</h2>
            <div class="kt-plans">
              <div class="kt-plancard" data-kt-plancard="free">
                <h3>{copy.free}</h3>
                <ul>{copy.freeList.map((x) => <li><Icon name="check" size={16} />{x}</li>)}</ul>
              </div>
              <div class="kt-plancard" data-kt-plancard="pro">
                <h3>{copy.pro} <span class="kt-hint">· {copy.proPrice}</span></h3>
                <ul>{copy.proList.map((x) => <li><Icon name="check" size={16} />{x}</li>)}</ul>
              </div>
            </div>
            <p class="kt-hint">{copy.planHint}</p>
          </section>
        </div>

        <div class="kt-col">
          <section class="kt-box" aria-labelledby="kt-groups-h">
            <h2 class="kt-box__title" id="kt-groups-h">{copy.groups}</h2>
            <p class="kt-hint">{copy.groupsHint}</p>
            <div class="kt-table">
              <table>
                <thead><tr><th scope="col">{copy.thGroup}</th><th scope="col">{copy.thDiscount}</th><th scope="col">{copy.thExample}</th><th scope="col"><span class="sr-only">Not</span></th></tr></thead>
                <tbody data-kt-groups></tbody>
              </table>
            </div>
          </section>

          <section class="kt-box" aria-labelledby="kt-dealers-h">
            <h2 class="kt-box__title" id="kt-dealers-h">{copy.dealers}</h2>
            <div class="kt-table">
              <table>
                <thead><tr><th scope="col">{copy.thDealer}</th><th scope="col">{copy.thCode}</th><th scope="col">{copy.thDealerGroup}</th></tr></thead>
                <tbody data-kt-dealers></tbody>
              </table>
            </div>
          </section>

          <section class="kt-box" aria-labelledby="kt-bulk-h">
            <h2 class="kt-box__title" id="kt-bulk-h">{copy.bulk} <span class="kt-badge kt-badge--pro" data-kt-bulk-badge>Pro</span></h2>
            <p class="kt-hint">{copy.bulkHint}</p>
            <form class="kt-bulk" data-kt-bulk>
              <div class="kt-field"><label for="kt-b-pct">{copy.change}</label><input id="kt-b-pct" type="number" step="0.5" value="8" /></div>
              <div class="kt-field">
                <label for="kt-b-round">{copy.round}</label>
                <select id="kt-b-round"><option value="1">₺1</option><option value="5" selected>₺5</option><option value="10">₺10</option></select>
              </div>
              <button type="submit" class="kt-pill kt-pill--dark">{copy.applyAll}</button>
            </form>
            <p class="kt-status" data-kt-bulk-msg role="status" hidden></p>
          </section>

          <section class="kt-box" aria-labelledby="kt-products-h">
            <h2 class="kt-box__title" id="kt-products-h">{copy.products} <span class="kt-count" data-kt-count></span></h2>
            <div class="kt-meter" data-kt-meter><i></i></div>
            <div class="kt-table">
              <table class="kt-products">
                <thead>
                  <tr><th scope="col">{copy.thProductCode}</th><th scope="col">{copy.thProduct}</th><th scope="col">{copy.thPrice}</th><th scope="col">{copy.thVis}</th><th scope="col">{copy.thStock}</th><th scope="col"><span class="sr-only">{copy.removeLogo}</span></th></tr>
                </thead>
                <tbody data-kt-products></tbody>
              </table>
            </div>
            <div class="kt-actions">
              <button type="button" class="kt-pill kt-pill--line" data-kt-add><Icon name="spark" size={16} />{copy.addProduct}</button>
              <span class="kt-hint" data-kt-products-msg aria-live="polite"></span>
            </div>
            <details class="kt-import">
              <summary>{copy.importTitle}</summary>
              <form data-kt-import>
                <p class="kt-hint">{copy.importHint}</p>
                <label class="sr-only" for="kt-import-text">{copy.importLabel}</label>
                <textarea id="kt-import-text" rows="4" placeholder={copy.importPlaceholder}></textarea>
                <button type="submit" class="kt-pill kt-pill--dark">{copy.importBtn}</button>
                <p class="kt-status" data-kt-import-msg role="status" hidden></p>
              </form>
            </details>
          </section>
        </div>
      </div>
    </div>

    <!-- PDF: printable catalog -->
    <div class="kt-view" id="kt-view-pdf" role="tabpanel" aria-labelledby="kt-tab-pdf" hidden>
      <div class="kt-pdfbar">
        <div class="kt-field"><label for="kt-pdf-group">{copy.pdfGroup}</label><select id="kt-pdf-group" data-kt-pdf-group></select></div>
        <button type="button" class="kt-pill kt-pill--dark" data-kt-print>{copy.pdfSave}</button>
      </div>
      <p class="kt-hint kt-pdfhint">{copy.pdfHint}</p>
      <div class="kt-pages" data-kt-pages></div>
    </div>
  </section>
</Base>

<style>
  .kt-head-links {
    margin-top: 1.5rem;
  }
</style>

<style is:global>
  /* Kartela demo. Markup is filled in by scripts/kartela.ts, so rules are global and scoped by .kt. */
  .kt {
    --kt-brand: #0f5c4d;
    --kt-surface: var(--c-light);
    --kt-sunk: var(--c-band);
    --kt-r: 14px;
    padding-bottom: var(--section);
  }

  .kt [hidden] {
    display: none !important;
  }

  .kt-note {
    padding: 1rem 1.25rem;
    border-radius: var(--kt-r);
    background: var(--kt-sunk);
  }

  .kt-label,
  .kt-field__label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .kt-hint {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--c-muted);
  }

  .kt input[type='text'],
  .kt input[type='tel'],
  .kt input[type='number'],
  .kt input[type='search'],
  .kt select,
  .kt textarea {
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.9rem;
    border: var(--stroke) solid color-mix(in srgb, var(--c-dark) 30%, transparent);
    border-radius: 12px;
    background: var(--kt-surface);
    color: var(--c-dark);
    font: inherit;
    font-size: 1rem;
  }

  .kt textarea {
    min-height: 7rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.875rem;
    resize: vertical;
  }

  .kt :is(input, select, textarea):focus-visible {
    outline: 2px solid var(--c-dark);
    outline-offset: 1px;
  }

  /* Pills: the site's button shape without the arrow. */
  .kt-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 1.15rem;
    border: var(--stroke) solid var(--c-dark);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--c-dark);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .kt-pill--line:hover {
    background: var(--c-dark);
    color: var(--c-light);
  }

  .kt-pill--dark {
    background: var(--c-dark);
    color: var(--c-light);
  }

  .kt-pill--dark:hover {
    background: var(--c-dark-soft);
  }

  .kt-pill--accent {
    border-color: var(--c-accent);
    background: var(--c-accent);
    color: var(--c-on-accent);
  }

  .kt-pill--accent:hover {
    border-color: var(--c-dark);
    background: var(--c-dark);
    color: var(--c-light);
  }

  .kt-pill:disabled,
  .kt-pill[aria-disabled='true'] {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  .kt-link {
    padding: 0.25rem;
    border: 0;
    background: none;
    color: var(--c-dark);
    font: inherit;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .kt-icon-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: var(--stroke) solid var(--c-line);
    border-radius: 50%;
    background: none;
    color: var(--c-dark);
    cursor: pointer;
  }

  .kt-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: var(--r-pill);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .kt-badge--pro {
    background: var(--c-dark);
    color: var(--c-light);
  }

  /* ---------- Toolbar ---------- */
  .kt-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: 1.25rem;
  }

  .kt-tabs,
  .kt-seg {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: var(--r-pill);
    background: var(--kt-sunk);
    border: var(--stroke) solid var(--c-line);
  }

  .kt-tab,
  .kt-seg button {
    min-height: 44px;
    padding: 0.4rem 1.1rem;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--c-muted);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
  }

  .kt-tab[aria-selected='true'],
  .kt-seg button[aria-pressed='true'] {
    background: var(--c-dark);
    color: var(--c-light);
  }

  .kt-seg button[data-kt-plan='pro'][aria-pressed='true'] {
    background: var(--c-accent);
    color: var(--c-on-accent);
  }

  .kt-plan {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  /* ---------- Catalog ---------- */
  .kt-shop {
    padding: clamp(1rem, 3vw, 2rem);
    border: var(--stroke) solid var(--c-line);
    border-radius: var(--r-card);
    background: var(--kt-surface);
  }

  .kt-firm {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 3px solid var(--kt-brand);
  }

  .kt-mark {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    flex: none;
    overflow: hidden;
    border-radius: 16px;
    background: var(--kt-brand);
    color: #fff;
    font-size: 1.75rem;
    font-weight: 700;
  }

  .kt-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #fff;
  }

  .kt-firm__name {
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.2;
  }

  .kt-firm__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1rem;
    margin: 0.35rem 0 0;
    font-size: 0.9375rem;
    color: var(--c-muted);
  }

  .kt-viewer {
    display: grid;
    gap: 0.85rem;
    margin-block: 1.5rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--kt-r);
    background: var(--kt-sunk);
  }

  .kt-viewer__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    align-items: baseline;
  }

  .kt-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .kt-chip {
    min-height: 44px;
    padding: 0.4rem 1rem;
    border: var(--stroke) solid color-mix(in srgb, var(--c-dark) 35%, transparent);
    border-radius: var(--r-pill);
    background: var(--kt-surface);
    color: var(--c-dark);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .kt-chip[aria-pressed='true'] {
    border-color: var(--c-dark);
    background: var(--c-dark);
    color: var(--c-light);
  }

  .kt-login {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.75rem;
  }

  .kt .kt-login input {
    width: 12rem;
    text-transform: uppercase;
  }

  .kt-who {
    margin: 0;
    font-size: 0.9375rem;
  }

  .kt-who b {
    font-weight: 600;
  }

  .kt-who .kt-warn,
  .kt-warn {
    color: #a12a1f;
  }

  :root[data-theme='dark'] .kt-warn {
    color: #f08a7e;
  }

  .kt-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 1.25rem;
  }

  .kt-search {
    position: relative;
    display: flex;
    align-items: center;
    width: min(100%, 18rem);
  }

  .kt-search svg {
    position: absolute;
    left: 0.85rem;
    color: var(--c-muted);
    pointer-events: none;
  }

  .kt-search input[type='search'] {
    padding-left: 2.5rem;
    border-radius: var(--r-pill);
  }

  .kt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16.5rem), 1fr));
    gap: 1rem;
  }

  .kt-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: var(--stroke) solid var(--c-line);
    border-radius: var(--kt-r);
    background: var(--kt-surface);
  }

  /* Fabric swatch: the colour of the chosen variant with a weave texture on top. */
  .kt-swatch {
    position: relative;
    aspect-ratio: 4 / 3;
    background-color: var(--sw);
    box-shadow: inset 0 -3rem 4rem -2rem rgb(0 0 0 / 0.12);
    transition: background-color var(--dur) var(--ease-out);
  }

  .kt-swatch--terry {
    background-image:
      radial-gradient(rgb(255 255 255 / 0.2) 1px, transparent 1.7px),
      radial-gradient(rgb(0 0 0 / 0.13) 1px, transparent 1.7px);
    background-size:
      6px 6px,
      6px 6px;
    background-position:
      0 0,
      3px 3px;
  }

  .kt-swatch--waffle {
    background-image:
      linear-gradient(rgb(0 0 0 / 0.16) 2px, transparent 2px),
      linear-gradient(90deg, rgb(0 0 0 / 0.16) 2px, transparent 2px);
    background-size: 15px 15px;
  }

  .kt-swatch--satin {
    background-image: linear-gradient(115deg, transparent 28%, rgb(255 255 255 / 0.34) 47%, transparent 66%);
  }

  .kt-swatch--muslin {
    background-image:
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.08) 0 1px, transparent 1px 4px),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.14) 0 1px, transparent 1px 4px);
  }

  .kt-swatch--percale {
    background-image: repeating-linear-gradient(45deg, rgb(255 255 255 / 0.12) 0 1px, transparent 1px 3px);
  }

  .kt-swatch--pestemal {
    background-image: repeating-linear-gradient(90deg, transparent 0 22px, rgb(255 255 255 / 0.55) 22px 26px, transparent 26px 30px, rgb(0 0 0 / 0.18) 30px 33px);
  }

  .kt-swatch__code,
  .kt-swatch__badges span {
    position: absolute;
    padding: 0.3rem 0.65rem;
    border-radius: var(--r-pill);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .kt-swatch__code {
    left: 0.75rem;
    bottom: 0.75rem;
    background: rgb(18 16 13 / 0.72);
    color: #f5f6f7;
    letter-spacing: 0.04em;
    backdrop-filter: blur(6px);
  }

  .kt-swatch__badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    gap: 0.4rem;
  }

  .kt-swatch__badges span {
    position: static;
    background: #f5f6f7;
    color: #12100d;
  }

  .kt-swatch__badges .is-new {
    background: var(--c-accent);
    color: var(--c-on-accent);
  }

  .kt-swatch__badges .is-out {
    background: #12100d;
    color: #f5f6f7;
  }

  .kt-card__body {
    display: grid;
    flex: 1;
    gap: 0.85rem;
    padding: 1rem 1rem 1.1rem;
  }

  .kt-card__name {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .kt-card__spec {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    color: var(--c-muted);
  }

  .kt-dots {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  /* 24px dots with a 44px hit area. */
  .kt-dot {
    position: relative;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 2px solid var(--kt-surface);
    border-radius: 50%;
    background: var(--sw);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--c-dark) 25%, transparent);
    cursor: pointer;
  }

  .kt-dot::after {
    content: '';
    position: absolute;
    inset: -9px;
  }

  .kt-dot[aria-pressed='true'] {
    box-shadow: 0 0 0 2px var(--c-dark);
  }

  .kt-dotname {
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
    color: var(--c-muted);
  }

  .kt-price {
    display: grid;
    gap: 0.15rem;
    align-content: start;
    min-height: 3.6rem;
    padding-top: 0.85rem;
    border-top: var(--stroke) dashed var(--c-line);
  }

  .kt-price__value {
    font-size: 1.5rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
  }

  .kt-price__state {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
  }

  .kt-price__sub {
    font-size: 0.8125rem;
    color: var(--c-muted);
  }

  .kt-buy {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: auto;
  }

  .kt-step {
    display: flex;
    align-items: center;
    height: 44px;
    border: var(--stroke) solid color-mix(in srgb, var(--c-dark) 30%, transparent);
    border-radius: var(--r-pill);
  }

  .kt-step button {
    width: 40px;
    height: 42px;
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    color: var(--c-dark);
    font-size: 1.15rem;
    cursor: pointer;
  }

  .kt-step span {
    min-width: 3.6rem;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .kt-buy .kt-pill {
    flex: 1;
    padding-inline: 0.75rem;
  }

  .kt-watermark {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.85rem;
    margin: 1.75rem 0 0;
    padding: 0.85rem;
    border: var(--stroke) dashed var(--c-line);
    border-radius: var(--kt-r);
    font-size: 0.875rem;
    color: var(--c-muted);
  }

  .kt-watermark__logo {
    font-weight: 700;
    color: var(--c-dark);
  }

  .kt-orderbar {
    position: sticky;
    bottom: 1rem;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    max-width: min(100%, 44rem);
    margin-top: 1rem;
    padding: 0.5rem 0.5rem 0.5rem 1.25rem;
    border-radius: var(--r-pill);
    background: var(--c-dark);
    color: var(--c-light);
    font-variant-numeric: tabular-nums;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.18);
  }

  .kt-orderbar .kt-pill {
    margin-left: auto;
  }

  .kt-orderbar .kt-pill--accent:hover {
    border-color: var(--c-light);
    background: var(--c-light);
    color: var(--c-dark);
  }

  .kt-dialog {
    width: min(40rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 0;
    border-radius: var(--r-card);
    background: var(--c-light);
    color: var(--c-dark);
  }

  .kt-dialog::backdrop {
    background: var(--c-scrim);
  }

  .kt-dialog__body {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.1rem, 3vw, 1.75rem);
  }

  .kt-dialog__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .kt-lines {
    border-top: var(--stroke) solid var(--c-line);
  }

  .kt-line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0;
    border-bottom: var(--stroke) solid var(--c-line);
    font-size: 0.9375rem;
  }

  .kt-line small {
    display: block;
    color: var(--c-muted);
    font-size: 0.8125rem;
  }

  .kt-line__sum {
    font-variant-numeric: tabular-nums;
  }

  .kt-total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 0;
  }

  .kt-total b {
    font-size: 1.375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .kt-msg {
    max-height: 14rem;
    margin: 0.4rem 0 0;
    padding: 0.9rem 1rem;
    overflow: auto;
    border-radius: 12px;
    background: var(--kt-sunk);
    font-family: inherit;
    font-size: 0.875rem;
    white-space: pre-wrap;
  }

  .kt-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  /* ---------- Panel ---------- */
  .kt-panel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    align-items: start;
    gap: 1.25rem;
  }

  .kt-col {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  .kt-box {
    display: grid;
    gap: 1rem;
    min-width: 0;
