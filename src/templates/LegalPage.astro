---
import type { Locale, Page } from '@/content/schema';
import { translationPaths } from '@/lib/cms';
import { formatDate, pagePath } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import PortableText from '@/components/PortableText.astro';

interface Props {
  lang: Locale;
  page: Page;
}
const { lang, page } = Astro.props;
const s = t(lang);
const alternates = await translationPaths('page', page.translationKey, pagePath);
---

<Base lang={lang} title={page.seo.title ?? page.title} description={page.seo.description ?? page.intro} alternates={alternates}>
  <PageHeader lang={lang} title={page.title} intro={page.intro}>
    <p class="updated">{s.lastUpdated}: <time datetime={page.updatedAt}>{formatDate(page.updatedAt, lang)}</time></p>
  </PageHeader>
  <div class="container legal">
    <PortableText value={page.body} />
  </div>
</Base>

<style>
  .updated {
    margin-top: 1rem;
    color: var(--c-muted);
    font-size: var(--fs-xs);
  }

  .legal {
    padding-bottom: var(--section);
  }

</style>
