---
import type { Locale, Post } from '@/content/schema';
import { translationPaths } from '@/lib/cms';
import { breadcrumbLd } from '@/lib/seo';
import { shareImageUrl } from '@/lib/images';
import { plainWords } from '@/lib/portable-text';
import { formatDate, postPath, routes } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import PortableText from '@/components/PortableText.astro';
import Img from '@/components/Img.astro';
import Button from '@/components/Button.astro';
import CtaBand from '@/components/CtaBand.astro';
import PostToc from '@/components/PostToc.astro';
import PostFacts from '@/components/PostFacts.astro';
import Notched from '@/components/Notched.astro';
import { headings } from '@/lib/portable-text';

interface Props {
  lang: Locale;
  post: Post;
}
const { lang, post } = Astro.props;
const s = t(lang);
const alternates = await translationPaths('post', post.translationKey, postPath);
const site = Astro.site ?? new URL('https://sunworks.studio');
const url = new URL(postPath(lang, post.slug.current), site).href;
const shareImage = await shareImageUrl(post.image, site);
const ld = [
  breadcrumbLd(site, [
    { label: s.home, href: routes.home[lang] },
    { label: s.blogTitle, href: routes.blog[lang] },
    { label: post.title, href: postPath(lang, post.slug.current) },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.excerpt,
    datePublished: post.publishedAt,
    dateModified: post.updatedAt ?? post.publishedAt,
    inLanguage: lang,
    author: { '@type': 'Organization', name: post.author, url: new URL(routes.home[lang], site).href },
    publisher: { '@type': 'Organization', name: post.author, logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', site).href } },
    mainEntityOfPage: url,
    image: shareImage,
    keywords: post.tags.join(', '),
    wordCount: plainWords(post.body),
  },
];
---

<Base lang={lang} title={post.seo.title ?? post.title} description={post.seo.description ?? post.excerpt} alternates={alternates} type="article" jsonLd={ld} image={shareImage}>
  <article>
    <PageHeader lang={lang} title={post.title} intro={post.excerpt} crumbs={[{ label: s.blogTitle, href: routes.blog[lang] }]} wide>
      <div class="post-info">
        {
          post.tags.length > 0 && (
            <ul class="post-tags" aria-label={s.tags}>
              {post.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
        <p class="meta">
          <span>{s.by} <strong>{post.author}</strong></span>
          <span>{s.publishedOn}: <time datetime={post.publishedAt}>{formatDate(post.publishedAt, lang)}</time></span>
          {
            post.updatedAt && (
              <span>
                {s.updatedOn}: <time datetime={post.updatedAt}>{formatDate(post.updatedAt, lang)}</time>
              </span>
            )
          }
        </p>
      </div>
    </PageHeader>
    <div class="container">
      <Notched corner="bl" ratio="1284 / 540" hover={false} fit class="post-media">
        <Img image={post.image} widths={[640, 960, 1284, 1920]} sizes="(max-width: 1440px) 92vw, 1284px" priority />
        <PostFacts slot="corner" lang={lang} post={post} url={url} />
      </Notched>
    </div>
    <div class="container body section">
      <div class="body__main">
        <PortableText value={post.body} />
        <p class="back"><Button href={routes.blog[lang]}>{s.backToBlog}</Button></p>
      </div>
      <aside class="body__aside"><PostToc items={headings(post.body)} label={s.onThisPage} /></aside>
    </div>
  </article>
  <CtaBand lang={lang} />
</Base>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    color: var(--c-muted);
    font-size: var(--fs-xs);
  }

  /* Taller crop on phones so the facts card in the notch keeps some photo around it. */
  @media (max-width: 560px) {
    .body :global(.post-media),
    :global(.post-media) {
      --ratio: 4 / 3 !important;
    }
  }

  .post-info {
    display: grid;
    justify-items: end;
    gap: 0.9rem;
    padding-bottom: 0.35rem;
  }

  .post-info .meta {
    justify-content: flex-end;
    margin-top: 0;
  }

  @media (max-width: 900px) {
    .post-info {
      justify-items: start;
      margin-top: 1.5rem;
    }

    .post-info .meta {
      justify-content: flex-start;
    }
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-tags li {
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--c-line);
    border-radius: var(--r-pill);
    font-size: var(--fs-xs);
    font-weight: 500;
  }

  .meta strong {
    color: var(--c-dark);
    font-weight: 600;
  }


  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 17rem);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  /* Stretch to the article's height so the sticky TOC has room to travel. */
  .body__aside {
    align-self: stretch;
  }

  .body__main {
    display: grid;
    justify-items: start;
  }

  @media (max-width: 1100px) {
    .body {
      grid-template-columns: 1fr;
    }

    .body__aside {
      display: none;
    }
  }

  .body :global(.prose) {
    width: 100%;
  }

  .back {
    width: 100%;
    max-width: 44rem;
    margin-top: 3rem;
  }
</style>
