---
import type { Locale, Post } from '@/content/schema';
import { getTranslation } from '@/lib/cms';
import { breadcrumbLd } from '@/lib/seo';
import { resolveImage } from '@/lib/images';
import { formatDate, postPath, routes } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import PortableText from '@/components/PortableText.astro';
import Notched from '@/components/Notched.astro';
import Img from '@/components/Img.astro';
import Button from '@/components/Button.astro';
import CtaBand from '@/components/CtaBand.astro';

interface Props {
  lang: Locale;
  post: Post;
}
const { lang, post } = Astro.props;
const s = t(lang);
const other: Locale = lang === 'tr' ? 'en' : 'tr';
const translation = await getTranslation('post', post.translationKey, other);
const alternates: Partial<Record<Locale, string>> = { [lang]: postPath(lang, post.slug.current) };
if (translation) alternates[other] = postPath(other, translation.slug.current);
const site = Astro.site ?? new URL('https://sunworks.studio');
const url = new URL(postPath(lang, post.slug.current), site).href;
const img = resolveImage(post.image);
const ld = [
  breadcrumbLd(site, [
    { label: s.home, href: routes.home[lang] },
    { label: s.blogTitle, href: routes.blog[lang] },
    { label: post.title, href: postPath(lang, post.slug.current) },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.excerpt,
    datePublished: post.publishedAt,
    dateModified: post.updatedAt ?? post.publishedAt,
    inLanguage: lang,
    author: { '@type': 'Person', name: post.author },
    mainEntityOfPage: url,
    image: img.kind === 'remote' ? img.src : undefined,
  },
];
---

<Base lang={lang} title={post.seo.title ?? post.title} description={post.seo.description ?? post.excerpt} alternates={alternates} type="article" jsonLd={ld}>
  <article>
    <PageHeader lang={lang} title={post.title} intro={post.excerpt} crumbs={[{ label: s.blogTitle, href: routes.blog[lang] }]}>
      <p class="meta">
        <span>{s.by} <strong>{post.author}</strong></span>
        <span>{s.publishedOn}: <time datetime={post.publishedAt}>{formatDate(post.publishedAt, lang)}</time></span>
        {
          post.updatedAt && (
            <span>
              {s.updatedOn}: <time datetime={post.updatedAt}>{formatDate(post.updatedAt, lang)}</time>
            </span>
          )
        }
      </p>
    </PageHeader>
    <div class="container">
      <Notched corner="bl" nw="clamp(160px, 18vw, 240px)" nh="clamp(56px, 5vw, 68px)" ratio="1284 / 540" hover={false}>
        <Img image={post.image} widths={[640, 960, 1284, 1920]} sizes="(max-width: 1440px) 92vw, 1284px" priority />
        <ul slot="corner" class="tags" aria-label={s.tags}>
          {post.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </Notched>
    </div>
    <div class="container body section">
      <PortableText value={post.body} />
      <p class="back"><Button href={routes.blog[lang]}>{s.backToBlog}</Button></p>
    </div>
  </article>
  <CtaBand lang={lang} />
</Base>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    color: var(--c-muted);
    font-size: var(--fs-xs);
  }

  .meta strong {
    color: var(--c-dark);
    font-weight: 600;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  .tags li {
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--c-dark);
    border-radius: var(--r-pill);
  }

  .body {
    display: grid;
    justify-items: start;
  }

  .body :global(.prose) {
    width: 100%;
  }

  .back {
    width: 100%;
    max-width: 44rem;
    margin-top: 3rem;
  }
</style>
