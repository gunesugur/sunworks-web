---
import type { Locale, Service } from '@/content/schema';
import { getServices, getSettings, translationPaths } from '@/lib/cms';
import { breadcrumbLd } from '@/lib/seo';
import { shareImageUrl } from '@/lib/images';
import { routes, servicePath } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import PortableText from '@/components/PortableText.astro';
import Notched from '@/components/Notched.astro';
import Img from '@/components/Img.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import CtaBand from '@/components/CtaBand.astro';

interface Props {
  lang: Locale;
  service: Service;
}
const { lang, service } = Astro.props;
const s = t(lang);
const [alternates, all, settings] = await Promise.all([
  translationPaths('service', service.translationKey, servicePath),
  getServices(lang),
  getSettings(lang),
]);
const others = all.filter((x) => x._id !== service._id);
const site = Astro.site ?? new URL('https://sunworks.studio');
const shareImage = await shareImageUrl(service.image, site);
const TOPICS: Record<string, string> = { 'service-wordpress': 'wordpress', 'service-shopify': 'shopify', 'service-support': 'support', 'service-ai': 'ai' };
const contactHref = `${routes.contact[lang]}?topic=${TOPICS[service.translationKey] ?? 'other'}`;
const ld = [
  breadcrumbLd(site, [
    { label: s.home, href: routes.home[lang] },
    { label: s.servicesTitle, href: routes.services[lang] },
    { label: service.title, href: servicePath(lang, service.slug.current) },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.headline ?? service.title,
    serviceType: service.title,
    description: service.excerpt,
    provider: { '@type': 'ProfessionalService', name: settings.siteName, url: new URL(routes.home[lang], site).href },
    areaServed: 'TR',
    image: shareImage,
    url: new URL(servicePath(lang, service.slug.current), site).href,
  },
  ...(service.faq?.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: service.faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
        },
      ]
    : []),
];
---

<Base lang={lang} title={service.seo.title ?? service.title} description={service.seo.description ?? service.excerpt} alternates={alternates} jsonLd={ld} image={shareImage}>
  <PageHeader
    lang={lang}
    title={service.headline ?? service.title}
    intro={service.excerpt}
    crumbs={[{ label: s.servicesTitle, href: routes.services[lang] }]}
  />

  <div class="container">
    <Notched corner="br" nw="clamp(96px, 9vw, 120px)" nh="clamp(96px, 9vw, 120px)" ratio="1284 / 520" class="detail__media" hover={false}>
      <Img image={service.image} widths={[640, 960, 1284, 1920]} sizes="(max-width: 1440px) 92vw, 1284px" priority />
      <span slot="corner" class="detail__icon" aria-hidden="true"><Icon name={service.icon} size={34} /></span>
    </Notched>
  </div>

  <section class="container detail section">
    <PortableText value={service.body} class="detail__body" />
    <aside class="detail__aside" aria-labelledby="included-title">
      <div class="included">
        <h2 id="included-title" class="h3">{s.included}</h2>
        <ul>
          {
            service.deliverables.map((d, i) => (
              <li data-reveal style={`--reveal-i:${i}`}>
                <Icon name="check" size={20} />
                <span>{d}</span>
              </li>
            ))
          }
        </ul>
        <Button href={contactHref} variant="solid">{s.askAbout}</Button>
      </div>
    </aside>
  </section>

  {
    service.faq?.length ? (
      <section class="container faq" aria-labelledby="faq-title">
        <h2 id="faq-title" class="h2">{s.faqTitle}</h2>
        <div class="faq__list">
          {service.faq.map((f) => (
            <details class="faq__item" data-reveal>
              <summary>
                <h3 class="faq__q">{f.question}</h3>
                <span class="faq__toggle" aria-hidden="true" />
              </summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </div>
      </section>
    ) : null
  }

  <nav class="container more" aria-labelledby="more-title">
    <h2 id="more-title" class="h3">{s.otherServices}</h2>
    <ul>
      {
        others.map((o) => (
          <li>
            <a href={servicePath(lang, o.slug.current)}>
              <Icon name={o.icon} size={22} />
              <span>{o.title}</span>
              <Icon name="arrow" size={16} class="more__arrow" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <CtaBand lang={lang} />
</Base>

<style>
  .container :global(.detail__media) {
    max-height: 70vh;
  }

  .detail__icon {
    display: grid;
    place-items: center;
    width: calc(100% - 16px);
    height: calc(100% - 16px);
    margin: 16px 0 0 16px;
    border-radius: 50%;
    background: var(--c-accent);
    color: var(--c-on-accent);
    animation: spin-in 1.2s var(--ease-out) both;
  }

  @keyframes spin-in {
    from {
      transform: rotate(-90deg) scale(0.6);
      opacity: 0;
    }
  }

  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .included {
    position: sticky;
    top: 2rem;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--r-card);
    background: var(--c-band);
  }

  .included ul {
    display: grid;
    gap: 0.9rem;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
  }

  .included li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .included li :global(.icon) {
    margin-top: 0.25em;
  }

  .more {
    padding-bottom: var(--section);
  }

  .more ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .more a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 48px;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--c-line);
    border-radius: var(--r-pill);
    font-size: var(--fs-small);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  .more a:hover {
    border-color: var(--c-dark);
    background: var(--c-band);
  }

  .more a :global(.more__arrow) {
    transition: transform var(--dur) var(--ease-out);
  }

  .more a:hover :global(.more__arrow) {
    transform: rotate(45deg);
  }

  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: start;
    padding-bottom: var(--section);
  }

  .faq__list {
    border-top: 1px solid var(--c-line);
  }

  .faq__item {
    border-bottom: 1px solid var(--c-line);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 0;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__q {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .faq__toggle {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border: 1px solid var(--c-line);
    border-radius: 50%;
    transition:
      transform var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  .faq__toggle::before,
  .faq__toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1.5px;
    margin: -0.75px 0 0 -6px;
    background: currentColor;
  }

  .faq__toggle::after {
    transform: rotate(90deg);
    transition: transform var(--dur) var(--ease-out);
  }

  .faq__item:not([open]) summary:hover .faq__toggle {
    background: var(--c-band);
  }

  .faq__item[open] .faq__toggle {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-on-accent);
  }

  .faq__item[open] .faq__toggle::after {
    transform: rotate(0deg);
  }

  .faq__item p {
    max-width: 62ch;
    padding-bottom: 1.5rem;
    color: var(--c-muted);
  }

  @media (max-width: 900px) {
    .detail,
    .faq {
      grid-template-columns: 1fr;
    }
  }
</style>
