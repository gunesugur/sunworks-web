---
import type { Locale } from '@/content/schema';
import { getHome, getServices } from '@/lib/cms';
import { routes, servicePath } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import Base from '@/layouts/Base.astro';
import Img from '@/components/Img.astro';
import Notched from '@/components/Notched.astro';
import Button from '@/components/Button.astro';
import ArrowButton from '@/components/ArrowButton.astro';
import Tag from '@/components/Tag.astro';
import Asterisk from '@/components/Asterisk.astro';
import Icon from '@/components/Icon.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { toolLogos } from '@/lib/tool-logos';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const [home, services] = await Promise.all([getHome(lang), getServices(lang)]);
const s = t(lang);
const words = home.hero.title.split(' ');
const hl = home.highlight;
const ratios = ['1 / 1', '4 / 5', '5 / 4', '4 / 3', '1 / 1', '4 / 5'];
---

<Base lang={lang} title={home.seo.title} description={home.seo.description} alternates={{ tr: routes.home.tr, en: routes.home.en }}>
  <!-- Hero -->
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero__top">
      <h1 id="hero-title" class="h1 hero__title">
        {
          words.map((w, i) => (
            <span class="hero__word" style={`--w:${i}`}>
              <span>{w}</span>
            </span>
          ))
        }
      </h1>
      <div class="hero__aside">
        <p class="hero__note">
          <span class="hero__note-in">
            <span class="hero__star" data-spin aria-hidden="true"><Asterisk size="100%" /></span>
            <span>{home.hero.note}</span>
          </span>
        </p>
      </div>
    </div>

    <Notched corner="tr" nw="calc(var(--aside) + var(--hero-gap))" nh="var(--hero-nh)" class="hero__media" hover={false}>
      <div class="hero__img" data-parallax="0.06">
        <Img image={home.hero.image} widths={[640, 960, 1284, 1920, 2400]} sizes="(max-width: 1440px) 92vw, 1284px" priority />
      </div>
      <ul class="hero__tags" slot="overlay" aria-label={s.tags}>
        {
          home.hero.tags.map((tag, i) => (
            <li data-reveal style={`--reveal-i:${i}`}>
              <Tag variant={i === 0 ? 'solid' : 'glass'}>{tag}</Tag>
            </li>
          ))
        }
      </ul>
    </Notched>
  </section>

  <!-- Tools band: brand marks drift sideways and speed up with the scroll (scripts/velocity.ts) -->
  <section class="tools" aria-labelledby="tools-title" data-velocity>
    <h2 id="tools-title" class="sr-only">{home.tools.title}</h2>
    <button type="button" class="tools__toggle" aria-pressed="false" data-marquee-toggle data-label-pause={s.pause} data-label-play={s.play}>
      <span class="sr-only" data-marquee-label>{s.pause}</span>
      <span class="tools__toggle-icon" aria-hidden="true"></span>
    </button>
    <div class="tools__viewport" data-marquee>
      <div class="tools__row" data-velocity-row data-speed="38" data-dir="1">
        {
          [0, 1].map((copy) => (
            <ul class="tools__track" aria-label={copy === 0 ? s.toolsLabel : undefined} aria-hidden={copy === 1 ? 'true' : undefined}>
              {home.tools.items.map((item) => {
                const logos = toolLogos(item);
                return (
                  <li class="tool" title={item}>
                    {logos.length ? (
                      <>
                        <span class="sr-only">{item}</span>
                        {logos.map((l) => (
                          <svg class="tool__logo" viewBox={l.viewBox} aria-hidden="true" focusable="false" style={`--brand-l:#${l.hexLight};--brand-d:#${l.hexDark};--s:${l.scale}`}>
                            <path d={l.path} />
                          </svg>
                        ))}
                      </>
                    ) : (
                      <span class="tool__name">{item}</span>
                    )}
                  </li>
                );
              })}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Intro split -->
  <section class="split container section" aria-labelledby="split-title">
    <h2 id="split-title" class="h2 split__title" data-reveal>
      <span class="focus" data-true-focus>
        {
          home.intro.title.split(' ').map((w, i, all) => (
            <>
              <span class="focus__word">{w}</span>
              {i < all.length - 1 ? ' ' : ''}
            </>
          ))
        }
        <span class="focus__frame" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      </span>
    </h2>
    <span class="split__rule" aria-hidden="true" data-reveal="fade"></span>
    <p class="split__text" data-reveal style="--reveal-i:1">{home.intro.text}</p>
    <div data-reveal style="--reveal-i:2"><Button href={home.intro.cta.href}>{home.intro.cta.label}</Button></div>
  </section>

  <!-- Two notched images -->
  <section class="duo container" aria-label={`${home.duo.firstTag} / ${home.duo.secondTag}`}>
    <Notched corner="tr" class="duo__a" ratio="1 / 1">
      <Img image={home.duo.first} widths={[400, 800]} sizes="(max-width: 900px) 92vw, 401px" />
      <ArrowButton slot="corner" href={home.duo.link.href} label={home.duo.link.label} />
      <Tag slot="overlay" variant="solid" class="duo__tag duo__tag--a">{home.duo.firstTag}</Tag>
    </Notched>
    <Notched corner="bl" class="duo__b" ratio="858 / 401" fit>
      <Img image={home.duo.second} widths={[640, 960, 1716]} sizes="(max-width: 900px) 92vw, 858px" />
      <Tag slot="corner" variant="outline">{home.duo.secondTag}</Tag>
    </Notched>
  </section>

  <!-- Approach -->
  <section class="approach container section" aria-labelledby="approach-title">
    <div class="approach__media" data-reveal="scale">
      <Notched corner="tl" ratio="591 / 627" fit>
        <Img image={home.approach.image} widths={[480, 800, 1200]} sizes="(max-width: 900px) 92vw, 591px" />
        <Tag slot="corner" variant="outline">{home.approach.tag}</Tag>
      </Notched>
    </div>
    <div class="approach__body">
      <h2 id="approach-title" class="h2" data-reveal>{home.approach.title}</h2>
      <span class="approach__rule" aria-hidden="true"></span>
      <ul class="features">
        {
          home.approach.items.map((item, i) => (
            <li class="feature" data-reveal style={`--reveal-i:${i}`}>
              <span class:list={['feature__icon', { 'feature__icon--outline': i % 2 === 1 }]} aria-hidden="true">
                <Icon name={item.icon} size={34} />
              </span>
              <div>
                <h3 class="h3 feature__title">{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <Button href={home.approach.cta.href}>{home.approach.cta.label}</Button>
    </div>
  </section>

  <!-- Highlight: one rolling figure beside a softly drifting column of commitments -->
  {
    hl && (
      <section class="highlight container section" aria-labelledby="highlight-title">
        <div class="highlight__lead">
          <p class="highlight__figure" data-odometer>
            <span class="sr-only">
              {hl.value}
              {hl.suffix}
            </span>
            <span class="odo" aria-hidden="true">
              {String(hl.value)
                .split('')
                .map((d, i, all) => (
                  <span class="odo__digit" style={`--d:${d};--i:${all.length - 1 - i}`}>
                    <span class="odo__strip">
                      {Array.from({ length: 20 }, (_, n) => (
                        <span>{n % 10}</span>
                      ))}
                    </span>
                  </span>
                ))}
              {hl.suffix && <span class="odo__suffix" data-suffix={hl.suffix} />}
            </span>
          </p>
          <h2 id="highlight-title" class="h3 highlight__title">
            {hl.title}
          </h2>
          <p class="highlight__text">{hl.text}</p>
        </div>
        <ul class="sr-only" aria-label={s.figuresLabel}>
          {hl.items.map((it) => (
            <li>
              {it.title}: {it.text}
            </li>
          ))}
        </ul>
        <div class="drift" aria-hidden="true">
          {[0, 1].map((col) => (
            <div class:list={['drift__col', { 'drift__col--down': col === 1 }]}>
              {[0, 1].map(() => (
                <ul class="drift__track">
                  {hl.items
                    .filter((_, i) => (col === 0 ? i % 2 === 0 : i % 2 === 1) || hl.items.length < 6)
                    .map((it, i) => (
                      <li class:list={['drift__card', `drift__card--${(i + col) % 3}`]}>
                        <Icon name={it.icon} size={22} />
                        <strong>{it.title}</strong>
                        <span>{it.text}</span>
                      </li>
                    ))}
                </ul>
              ))}
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Figures (legacy): short commitments that count up once when they scroll into view (scripts/count.ts) -->
  {
    !home.highlight && home.stats && (
      <section class="figures container" aria-label={s.figuresLabel}>
        <ul class="figures__list">
          {home.stats.items.map((it, i) => (
            <li class="figure" data-reveal style={`--reveal-i:${i}`}>
              <span class="figure__value">
                <span class="figure__num" data-count={it.value}>
                  {it.value}
                </span>
                {it.suffix && <span class="figure__suffix">{it.suffix}</span>}
              </span>
              <span class="figure__label">{it.label}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Services -->
  <section class="services container section" aria-labelledby="services-title">
    <header class="services__head" data-reveal>
      <h2 id="services-title" class="h2">{home.servicesSection.title}</h2>
      <p class="lead">{home.servicesSection.text}</p>
    </header>
    <ul class="services__grid">
      {
        services.map((svc, i) => (
          <li data-reveal style={`--reveal-i:${i % 3}`}>
            <ServiceCard service={svc} href={servicePath(lang, svc.slug.current)} ratio={ratios[i % ratios.length] ?? '1 / 1'} label={s.viewService} />
          </li>
        ))
      }
    </ul>
    <div class="services__more">
      <Button href={routes.services[lang]} variant="solid" size="lg">{s.allServices}</Button>
    </div>
  </section>

  <!-- Process: an editorial list beside a sticky sunrise that climbs as the steps scroll past (scripts/journey.ts) -->
  <section class="process container section" id="process" aria-labelledby="process-title" data-journey>
    <div class="process__aside">
      <div class="process__sticky">
        <h2 id="process-title" class="h2" data-reveal>{home.process.title}</h2>
        <p class="lead process__lead" data-reveal style="--reveal-i:1">{home.process.text}</p>
        <div class="dial" aria-hidden="true">
          <svg class="dial__art" viewBox="0 0 200 120">
            <defs>
              <clipPath id="dial-sky"><rect width="200" height="96"></rect></clipPath>
            </defs>
            <g clip-path="url(#dial-sky)">
              <g class="dial__rays">
                {Array.from({ length: 12 }, (_, i) => <path d="M100 96V22" transform={`rotate(${i * 15 - 82.5} 100 96)`}></path>)}
              </g>
              <circle class="dial__sun" cx="100" cy="96" r="44"></circle>
            </g>
            <path class="dial__horizon" d="M8 96h184"></path>
          </svg>
          <p class="dial__count">
            <span class="dial__now" data-journey-now>01</span>
            <span class="dial__total">/ {String(home.process.steps.length).padStart(2, '0')}</span>
          </p>
        </div>
      </div>
    </div>
    <ol class="phases">
      {
        home.process.steps.map((step, i) => (
          <li class="phase" data-step>
            <span class="phase__num" aria-hidden="true" />
            <div class="phase__body">
              <h3 class="phase__title">
                <span class="sr-only">{`${s.stepLabel} ${i + 1}: `}</span>
                {step.title}
              </h3>
              <p class="phase__text">{step.text}</p>
              {step.deliverables?.length ? (
                <div class="phase__gets">
                  <p class="phase__gets-title">{s.youReceive}</p>
                  <ul>
                    {step.deliverables.map((d) => (
                      <li>
                        <Asterisk size="0.8em" />
                        {d}
                      </li>
                    ))}
                  </ul>
                </div>
              ) : null}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Ribbon: still until the page scrolls, then slides with it; rows run in opposite directions -->
  <section class="ribbon" aria-hidden="true" data-velocity>
    {
      [1, -1].map((dir) => (
        <div class:list={['ribbon__row', { 'ribbon__row--outline': dir < 0 }]} data-velocity-row data-speed="0" data-dir={dir}>
          {[0, 1].map(() => (
            <p class="ribbon__track">
              {home.hero.tags.map((tag) => (
                <span class="ribbon__item">
                  {tag}
                  <Asterisk size="0.6em" />
                </span>
              ))}
            </p>
          ))}
        </div>
      ))
    }
  </section>

  <!-- Closing -->
  <section class="closing container" aria-labelledby="closing-title">
    <Notched corner="tr" nw="var(--closing-nw)" nh="var(--closing-nh)" class="closing__media" ratio="1284 / 574">
      <div class="closing__img" data-parallax="0.05">
        <Img image={home.closing.image} widths={[640, 960, 1284, 1920, 2400]} sizes="(max-width: 1440px) 92vw, 1284px" />
      </div>
      <div slot="corner" class="closing__text">
        <h2 id="closing-title" class="closing__title">{home.closing.title}</h2>
        <ArrowButton href={home.closing.cta.href} label={home.closing.cta.label} size="sm" />
      </div>
      <div slot="overlay" class="closing__tag">
        <Tag variant="solid">{home.closing.tag}</Tag>
      </div>
    </Notched>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    --aside: clamp(230px, 25vw, 360px);
    --hero-gap: clamp(1rem, 2vw, 1.75rem);
    --hero-nh: clamp(92px, 7.6vw, 112px);
    padding-top: clamp(1.5rem, 4vw, 3.5rem);
  }

  .hero__top {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--aside);
    align-items: end;
    gap: var(--hero-gap);
  }

  .hero__title {
    padding-bottom: calc(var(--hero-nh) + 1rem);
  }

  .hero__word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.06em;
    margin-right: 0.25em;
  }

  .hero__word > span {
    display: inline-block;
    animation: word-in 1s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--w) * 70ms);
  }

  :global(html.intro) .hero__word > span {
    animation-delay: calc(1.75s + var(--w) * 70ms);
  }

  @keyframes word-in {
    from {
      transform: translate3d(0, 105%, 0);
    }
  }

  .hero__aside {
    display: grid;
    gap: 1.5rem;
  }

  .hero :global(.hero__media) {
    margin-top: calc(var(--hero-nh) * -1);
    height: clamp(380px, 36vw, 520px);
  }

  .hero__img {
    position: absolute;
    inset: -8% 0;
    transform: translate3d(0, var(--py, 0), 0);
    will-change: transform;
  }

  .hero__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.85);
  }

  /* Fills the notch cut out of the photo below and sits centred in it. */
  .hero__note {
    display: grid;
    align-items: center;
    height: var(--hero-nh);
    font-size: clamp(1rem, 0.85rem + 0.5vw, 1.375rem);
    line-height: 1.4;
  }

  .hero__note-in {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .hero__star {
    display: inline-block;
    flex: none;
    width: 1.4em;
    height: 1.4em;
    margin-top: -0.2em;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    transform: rotate(calc(var(--turns, 0) * 240deg));
    transition: transform 1.2s var(--ease-out);
  }

  .hero__tags {
    position: absolute;
    left: clamp(1rem, 2.5vw, 2rem);
    bottom: clamp(1rem, 2.5vw, 2rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    max-width: min(34rem, 80%);
    padding: 0;
    list-style: none;
  }

  /* ---------- Tools ---------- */
  .tools {
    position: relative;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-block: clamp(2.5rem, 4vw, 3rem);
    background: var(--c-band);
    text-align: center;
  }

  .tools__title {
    padding-inline: var(--gutter);
    color: var(--c-muted);
    font-size: var(--fs-lead);
    font-weight: 500;
  }

  .tools__viewport {
    margin-top: 2.25rem;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .tools__row {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .tools__track {
    display: flex;
    flex: none;
    align-items: center;
    gap: clamp(3rem, 7vw, 6.5rem);
    padding: 0.5rem clamp(1.5rem, 3.5vw, 3.25rem);
    list-style: none;
  }

  .tool {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--c-dark);
  }

  /* Monochrome in the site's ink; the real brand colour shows on hover. */
  .tool__logo {
    width: auto;
    height: calc(clamp(2.1rem, 1.6rem + 1.4vw, 3rem) * var(--s, 1));
    fill: currentColor;
    opacity: 0.82;
    transition:
      fill var(--dur) var(--ease-out),
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .tool__logo {
    --brand: var(--brand-l);
  }

  :global(html[data-theme='dark']) .tool__logo {
    --brand: var(--brand-d);
  }

  .tool:hover .tool__logo {
    fill: var(--brand);
    opacity: 1;
    transform: translate3d(0, -3px, 0) scale(1.06);
  }

  .tool__name {
    font-size: clamp(1.4rem, 1.1rem + 1.3vw, 2.25rem);
    font-weight: 600;
    white-space: nowrap;
  }

  :global(html:not(.js)) .tools__row {
    width: auto;
    justify-content: center;
  }

  :global(html:not(.js)) .tools__track {
    flex-wrap: wrap;
    justify-content: center;
    row-gap: 1.5rem;
  }

  :global(html:not(.js)) .tools__track + .tools__track,
  :global(html:not(.js)) .tools__toggle {
    display: none;
  }

  .tools__toggle {
    position: absolute;
    right: var(--gutter);
    top: clamp(2rem, 3.5vw, 2.5rem);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--c-dark);
    border-radius: 50%;
    background: var(--c-light);
    cursor: pointer;
  }

  .tools__toggle-icon {
    width: 12px;
    height: 12px;
    border-inline: 3px solid var(--c-dark);
  }

  .tools__toggle[aria-pressed='true'] .tools__toggle-icon {
    width: 0;
    height: 0;
    border-inline: 0;
    border-block: 7px solid transparent;
    border-left: 11px solid var(--c-dark);
    margin-left: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tools__viewport {
      mask-image: none;
    }

    .tools__row {
      width: auto;
      justify-content: center;
    }

    .tools__track {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 1.5rem;
    }

    .tools__track + .tools__track,
    .tools__toggle {
      display: none;
    }
  }

  :global(html[data-motion='reduce']) .tools__row {
    width: auto;
    justify-content: center;
  }

  :global(html[data-motion='reduce']) .tools__track {
    flex-wrap: wrap;
    justify-content: center;
    row-gap: 1.5rem;
  }

  :global(html[data-motion='reduce']) .tools__track + .tools__track,
  :global(html[data-motion='reduce']) .tools__toggle {
    display: none;
  }

  /* ---------- Split ---------- */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 472fr) 3px minmax(0, 421fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 5.25rem);
  }

  .split__rule {
    width: 3px;
    height: 129px;
    border-radius: 18px;
    background: var(--c-line);
  }

  /* True focus: one word at a time comes into focus inside accent corner marks (scripts/focus.ts). */
  .focus {
    position: relative;
    display: inline;
  }

  .focus__word {
    transition:
      filter 0.5s var(--ease-out),
      opacity 0.5s var(--ease-out);
  }

  .focus.is-focusing .focus__word:not(.is-focus) {
    filter: blur(3px);
    opacity: 0.45;
  }

  .focus__frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.55s var(--ease-out),
      width 0.55s var(--ease-out),
      height 0.55s var(--ease-out),
      opacity 0.4s ease;
  }

  .focus.has-frame .focus__frame {
    opacity: 1;
  }

  .focus__frame i {
    position: absolute;
    width: 0.32em;
    height: 0.32em;
    border: 0.07em solid var(--c-accent);
  }

  .focus__frame i:nth-child(1) {
    left: -0.14em;
    top: -0.06em;
    border-right: 0;
    border-bottom: 0;
  }

  .focus__frame i:nth-child(2) {
    right: -0.14em;
    top: -0.06em;
    border-left: 0;
    border-bottom: 0;
  }

  .focus__frame i:nth-child(3) {
    left: -0.14em;
    bottom: -0.06em;
    border-right: 0;
    border-top: 0;
  }

  .focus__frame i:nth-child(4) {
    right: -0.14em;
    bottom: -0.06em;
    border-left: 0;
    border-top: 0;
  }

  /* ---------- Duo ---------- */
  .duo {
    display: grid;
    grid-template-columns: minmax(0, 401fr) minmax(0, 858fr);
    gap: clamp(1rem, 1.8vw, 1.6rem);
    align-items: start;
  }

  .duo :global(.duo__tag) {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
  }

  /* ---------- Approach ---------- */
